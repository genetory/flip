# API
NODE_ENV=development
API_PORT=4000
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24

# Naver OAuth (https://developers.naver.com/apps/)
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_REDIRECT_URI=http://localhost:4000/auth/naver/callback

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Kakao OAuth (https://developers.kakao.com/console/app)
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=http://localhost:4000/auth/kakao/callback

OAUTH_STATE_SECRET=change-this-oauth-state-secret
SIGNUP_EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_BASE_URL=http://localhost:3000/verify-email
# Display From (e.g. "Aply <info@flip-ers.com>"). Domain must be authenticated via SPF/DKIM/DMARC.
EMAIL_FROM=
# Optional: address users see when they click "Reply". Defaults to EMAIL_SUPPORT_ADDRESS.
EMAIL_REPLY_TO=
# Optional: envelope (Return-Path) sender, used for bounces/SPF alignment. Defaults to SMTP_USER.
EMAIL_ENVELOPE_FROM=
# Support address rendered inside email body/footer.
EMAIL_SUPPORT_ADDRESS=info@flip-ers.com
# Public brand URL used as homepage link in email footer.
EMAIL_BRAND_URL=https://aply.global
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
OPENAI_API_KEY=
OPENAI_MATCHING_MODEL=gpt-5.4
OPENAI_TRANSLATION_MODEL=gpt-5.4-mini
# Career Launch LLM 안정성 튜닝(선택, 기본값 있음) — Phase 15
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2
LLM_DEDUP_TTL_MS=10000
OPENAI_MATCHING_MIN_COMPLETION_PERCENT=60
OPENAI_MATCHING_HIGH_COMPLETION_BONUS=8
OPENAI_MATCHING_LOW_COMPLETION_PENALTY=12

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PARTNER_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_OPS_ADMIN_URL=http://localhost:3002
PLATFORM_WEB_URL=http://localhost:3000
PARTNER_ADMIN_URL=http://localhost:3001
OPS_ADMIN_URL=http://localhost:3002

# PostgreSQL
DATABASE_URL=postgresql://careerbridge:careerbridge@localhost:5432/careerbridge?schema=public

# --------------------------
# Azure staging example
# --------------------------
# API app (api-staging)
# NODE_ENV=production
# API_PORT=4000
# DATABASE_URL=postgresql://<DB_ADMIN_USER>:<DB_PASSWORD>@pg-aply-staging.postgres.database.azure.com:5432/aply?sslmode=require
# JWT_SECRET=aply-staging-jwt-secret-change-this
# JWT_ACCESS_SECRET=aply-staging-jwt-access-secret-change-this
# JWT_REFRESH_SECRET=aply-staging-jwt-refresh-secret-change-this
# PLATFORM_WEB_URL=https://platform-web-staging.azurewebsites.net
# PARTNER_ADMIN_URL=https://partner-admin-staging.azurewebsites.net
# OPS_ADMIN_URL=https://ops-admin-staging.azurewebsites.net
# OPENAI_API_KEY=<optional>
# OPENAI_MATCHING_MODEL=gpt-5.4
# OPENAI_TRANSLATION_MODEL=gpt-5.4-mini
#
# Web app (platform-web-staging)
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=https://api-staging.azurewebsites.net

# Import company users from staging
COMPANY_USERS_API_URL=https://admin-staging.flip-ers.com/api/users/company-users
COMPANY_USERS_TOKEN=
COMPANY_USERS_PAGE_SIZE=20
# 0 means all pages
COMPANY_USERS_MAX_PAGES=0
# temporary password for newly created imported users
COMPANY_USERS_DEFAULT_PASSWORD=Temp!ChangeMe123

# Import job postings from staging
JOB_POSTINGS_API_URL=https://admin-staging.flip-ers.com/api/job-postings
JOB_POSTINGS_TOKEN=
JOB_POSTINGS_PAGE_SIZE=20
# 0 means all pages
JOB_POSTINGS_MAX_PAGES=0
# 1 to fetch /api/job-postings/{id} detail per item, 0 to skip
JOB_POSTINGS_FETCH_DETAIL=1
# one of DRAFT, OPEN, MATCHING, CLOSED
JOB_POSTINGS_DEFAULT_STATUS=OPEN
OPENAI_MATCHING_MAX_POOL=120
OPENAI_MATCHING_TEXT_MAX=280
