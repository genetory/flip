generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                                   String                        @id @default(uuid())
  email                                String
  emailVerified                        Boolean                       @default(false)
  isActive                             Boolean                       @default(true)
  // 이메일 알림 수신 여부(인앱 알림은 항상 유지). 사용자가 설정에서 끌 수 있다.
  emailNotifications                   Boolean                       @default(true)
  // 기업 인재풀 공개 동의 시각(유저 레벨 원천). 대표 이력서 교체와 무관하게 노출 유지.
  talentPoolConsentedAt                DateTime?
  suspendedAt                          DateTime?
  suspendedReason                      String?
  realName                             String?
  name                                 String?
  phoneNumber                          String?
  nationality                          String?
  affiliation                          String?
  birthDate                            DateTime?
  gender                               String?
  jobTitle                             String?
  profileImageUrl                      String?
  adminMemo                            String?
  passwordHash                         String?
  authProvider                         AuthProvider                  @default(EMAIL)
  providerId                           String?
  role                                 MemberRole                    @default(STUDENT)
  partnerType                          PartnerType?
  partnerOrgRole                       PartnerOrgUserRole?
  partnerOrganizationId                String?
  partnerOrganizationName              String?
  // Signup forensics — captured at /auth/register so ops can trace
  // bot/spam waves without a separate audit table. Null for legacy rows
  // and OAuth signups before this field was added.
  signupIp                             String?
  signupUserAgent                      String?
  signupReferer                        String?
  createdAt                            DateTime                      @default(now())
  updatedAt                            DateTime                      @updatedAt
  positionParticipants                 PositionMatchingParticipant[] @relation("PositionParticipantAuthor")
  positionProgressLogs                 PositionProgressLog[]         @relation("PositionLogAuthor")
  positionStatusHistories              PositionStatusHistory[]       @relation("PositionStatusAuthor")
  candidateProfile                     CandidateProfile?
  resumes                              Resume[]
  coverLetters                         CoverLetter[]
  couponRedemptions                    CouponRedemption[]
  aiUsages                             AiUsage[]
  aiWallet                             AiWallet?
  aiPointLogs                          AiPointLog[]
  sgcApplication                       SgcApplication?               @relation("SgcApplicationUser")
  refreshTokens                        RefreshToken[]
  emailVerificationTokens              EmailVerificationToken[]
  communityPosts                       CommunityPost[]
  communityPostLikes                   CommunityPostLike[]
  communityPostComments                CommunityPostComment[]
  partnerApplicantWorkflowsAsPartner   PartnerApplicantWorkflow[]    @relation("PartnerApplicantWorkflowPartnerUser")
  partnerApplicantWorkflowsAsCandidate PartnerApplicantWorkflow[]    @relation("PartnerApplicantWorkflowCandidateUser")
  candidateConnectionsAsPartner        CandidateConnectionRequest[]  @relation("CandidateConnPartner")
  candidateConnectionsAsCandidate      CandidateConnectionRequest[]  @relation("CandidateConnCandidate")
  talentEvents                         TalentEvent[]                 @relation("TalentEventUser")
  applications                         Application[]                 @relation("ApplicationCandidate")
  applicationStatusChanges             ApplicationStatusHistory[]    @relation("ApplicationStatusChangedBy")
  reportedIssues                       IssueReport[]                 @relation("IssueReportReporter")
  subjectIssues                        IssueReport[]                 @relation("IssueReportSubject")
  assignedIssues                       IssueReport[]                 @relation("IssueReportAssignee")
  assignmentsAssigned                  Assignment[]                  @relation("AssignmentAssignedBy")
  assignmentsReviewed                  Assignment[]                  @relation("AssignmentReviewedBy")
  programFeedbacks                     ProgramFeedback[]             @relation("ProgramFeedbackAuthor")
  careerLaunchFeedbacksReceived        CareerLaunchFeedback[]        @relation("CareerLaunchFeedbackStudent")
  careerLaunchFeedbacksAuthored        CareerLaunchFeedback[]        @relation("CareerLaunchFeedbackAuthor")
  careerResumeData                     CareerResumeData?             @relation("CareerResumeDataStudent")
  careerCoverLetterData                CareerCoverLetterData?        @relation("CareerCoverLetterDataStudent")
  careerLaunchProgress                 CareerLaunchProgress?         @relation("CareerLaunchProgressStudent")
  careerProfile                        CareerProfile?                @relation("CareerProfileStudent")
  careerProfileEvents                  CareerProfileEvent[]          @relation("CareerProfileEventStudent")
  careerExperiences                    CareerExperience[]            @relation("CareerExperienceStudent")
  careerJobTrials                      CareerJobTrial[]              @relation("CareerJobTrialStudent")
  careerTargetJobs                     CareerTargetJob[]             @relation("CareerTargetJobStudent")
  careerJobDecisionReport              CareerJobDecisionReport?      @relation("CareerJobDecisionReportStudent")
  careerApplicationTargets             CareerApplicationTarget[]     @relation("CareerApplicationTargetStudent")
  careerDocumentVersions               CareerDocumentVersion[]       @relation("CareerDocumentVersionStudent")
  careerApplicationPackages            CareerApplicationPackage[]    @relation("CareerApplicationPackageStudent")
  careerInterviewQuestionSets          CareerInterviewQuestionSet[]  @relation("CareerInterviewQuestionSetStudent")
  careerInterviewSessions              CareerInterviewSession[]      @relation("CareerInterviewSessionStudent")
  careerInterviewQuestions             CareerInterviewQuestion[]     @relation("CareerInterviewQuestionStudent")
  careerInterviewAnswers               CareerInterviewAnswer[]       @relation("CareerInterviewAnswerStudent")
  careerInterviewWeaknesses            CareerInterviewWeakness[]     @relation("CareerInterviewWeaknessStudent")
  careerInterviewCorrections           CareerInterviewCorrection[]   @relation("CareerInterviewCorrectionStudent")
  careerInterviewCorrectionAttempts    CareerInterviewCorrectionAttempt[] @relation("CareerInterviewCorrectionAttemptStudent")
  careerInterviewGrowthReport          CareerInterviewGrowthReport?  @relation("CareerInterviewGrowthReportStudent")
  careerLeagueScores                   CareerLeagueScore[]           @relation("CareerLeagueScoreStudent")
  careerAchievements                   CareerAchievement[]           @relation("CareerAchievementStudent")
  careerInterventions                  CareerIntervention[]          @relation("CareerInterventionStudent")
  careerEnrollments                    CareerEnrollment[]            @relation("CareerEnrollmentStudent")
  careerEmploymentOutcomes             CareerEmploymentOutcome[]     @relation("CareerEmploymentOutcomeStudent")
  careerLaunchSatisfactions            CareerLaunchSatisfaction[]    @relation("CareerLaunchSatisfactionStudent")
  careerPilotSurveys                   CareerPilotSurvey[]           @relation("CareerPilotSurveyStudent")
  careerQualitativeFeedbacks           CareerQualitativeFeedback[]   @relation("CareerQualitativeFeedbackStudent")
  careerActivityEvents                 CareerActivityEvent[]         @relation("CareerActivityEventStudent")
  organizationMemberships              OrganizationMembership[]      @relation("OrgMembershipUser")
  careerStaffAssignments               CareerStaffAssignment[]       @relation("CareerStaffAssignmentUser")
  careerLaunchCertificatesReceived     CareerLaunchCertificate[]     @relation("CareerLaunchCertificateStudent")
  careerLaunchCertificatesIssued       CareerLaunchCertificate[]     @relation("CareerLaunchCertificateIssuer")
  certificatesIssued                   Certificate[]                 @relation("CertificateIssuer")
  recommendationsIssued                Recommendation[]              @relation("RecommendationIssuer")
  schoolCreditReviews                  SchoolCreditRequest[]         @relation("SchoolCreditReviewer")
  notifications                        Notification[]
  applicationComments                  ApplicationComment[]          @relation("ApplicationCommentAuthor")
  partnerOrganization                  PartnerOrganization?          @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  createdPartnerJoinCodes              PartnerOrganizationJoinCode[]
  requestedPositionRevisions           PositionRevision[]            @relation("PositionRevisionRequester")
  reviewedPositionRevisions            PositionRevision[]            @relation("PositionRevisionReviewer")
  mockInterviewSessions                MockInterviewSession[]
  applicantDocSummary                  ApplicantDocSummary?

  @@unique([email, authProvider])
  @@unique([authProvider, providerId])
  @@index([role])
  @@index([partnerType])
  @@index([partnerOrgRole])
  @@index([partnerOrganizationId])
  @@index([emailVerified])
  @@index([phoneNumber])
  @@index([affiliation])
  @@index([authProvider])
}

enum AuthProvider {
  EMAIL
  NAVER
  KAKAO
  GOOGLE
}

enum CommunityPostCategory {
  FREE
  CAREER
  HELP
}

model EmailPreverificationToken {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
  @@index([verifiedAt])
  @@index([usedAt])
}

model PartnerSignupRequest {
  id               String    @id @default(uuid())
  companyName      String
  companyIndustry  String
  companySize      String
  requesterName    String
  requesterEmail   String
  requesterPhone   String?
  status           String    @default("PENDING")
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([requesterEmail])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

