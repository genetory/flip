model PartnerOrganization {
  id                               String                        @id @default(uuid())
  partnerType                      PartnerType
  name                             String
  slug                             String                        @unique
  companySize                      PartnerCompanySize?
  officeAddress                    String?
  website                          String?
  socialMedia                      String?
  industry                         PartnerIndustry
  description                      String?
  strengths                        String?
  adminMemo                        String?
  businessRegistrationDocumentData String?
  fourInsuranceSubscriberListData  String?
  companyLogoImageData             String?
  officePhotoImageData             String?
  verificationApproved             Boolean                       @default(false)
  verificationApprovedAt           DateTime?
  createdAt                        DateTime                      @default(now())
  updatedAt                        DateTime                      @updatedAt
  positions                        Position[]
  positionRevisions                PositionRevision[]
  users                            User[]
  joinCodes                        PartnerOrganizationJoinCode[]

  @@index([partnerType])
  @@index([companySize])
  @@index([industry])
  @@index([name])
  @@index([slug])
}

model PartnerOrganizationJoinCode {
  id                    String    @id @default(uuid())
  partnerOrganizationId String
  createdByUserId       String
  codeHash              String    @unique
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime  @default(now())

  partnerOrganization PartnerOrganization @relation(fields: [partnerOrganizationId], references: [id], onDelete: Cascade)
  createdByUser       User                @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([partnerOrganizationId])
  @@index([createdByUserId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Position {
  id                      String                      @id @default(uuid())
  partnerOrganizationId   String?
  sourceKind              PositionSourceKind          @default(INTERNAL)
  sourceProvider          PositionSourceProvider      @default(INTERNAL)
  sourceExternalId        String?
  sourceUrl               String?
  sourceFetchedAt         DateTime?
  sourceDeadlineDate      DateTime?
  title                   String
  status                  PositionStatus              @default(DRAFT)
  workType                String?
  employmentType          PositionEmploymentType      @default(UNPAID_INTERN)
  thumbnailImages         String[]                    @default([])
  eligibleVisas           String[]                    @default([])
  preferredNationalities  String[]                    @default([])
  communicationLanguages  String[]                    @default([])
  hiringProcess           String?
  preferredJobRole        String?
  jobAlertSentAt          DateTime? // 비자 매칭 지원자에게 잡 얼럿 발송한 시각(중복 방지)
  hiringCount             Int?
  workingHours            String?
  workLocation            String?
  startDate               DateTime?
  mainResponsibilities    String?
  requiredQualifications  String?
  preferredQualifications String?
  dressCode               String?
  wantsPreTraining        Boolean?
  additionalNotes         String?
  adminMemo               String?
  // 모의 면접(회사 저작) — intent: 면접에서 보려는 포인트, questions: 대표 질문(선택).
  // 지원자는 지원 여부와 무관하게 이걸로 연습+AI 피드백을 받는다.
  mockInterviewIntent     String?
  mockInterviewQuestions  String[]                    @default([])
  viewCount               Int                         @default(0)
  externalClickCount      Int                         @default(0)
  embedding               Unsupported("vector(768)")?
  embeddingUpdatedAt      DateTime?
  // Per-locale translation cache (keyed by BCP47 locale).
  // Shape: { en: { title, mainResponsibilities, requiredQualifications, ... } }
  // Filled lazily on first non-Korean view for INTERNAL postings.
  translations            Json?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  partnerOrganization  PartnerOrganization?          @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  matchingParticipants PositionMatchingParticipant[]
  progressLogs         PositionProgressLog[]
  statusHistories      PositionStatusHistory[]
  applicantWorkflows   PartnerApplicantWorkflow[]
  applications         Application[]
  revisions            PositionRevision[]

  @@unique([sourceProvider, sourceExternalId])
  @@index([partnerOrganizationId])
  @@index([sourceKind, sourceProvider])
  @@index([status])
  @@index([title])
  @@index([createdAt])
  // /positions "오직 Aply 에서만!" 탭 (sourceProvider=INTERNAL + status=OPEN +
  // ORDER BY createdAt DESC) 가 createdAt 단일 인덱스만 있을 땐 BUDDIES/WANTED 가
  // 위에 가득 쌓여서 INTERNAL 20개 찾을 때까지 heap 을 길게 끌고 갔다. 복합
  // 인덱스로 필터 + 정렬을 한번에 — Postgres 가 ASC 인덱스를 backward 스캔하므로
  // DESC 키워드는 불필요. id 까지 포함해 keyset 페이지네이션의 tiebreaker 도 커버.
  //
  // ⚠️ 이 인덱스는 마이그레이션 파일이 아니라 apps/api/scripts/sync-position-index.sh
  // 가 CREATE INDEX CONCURRENTLY 로 적용한다(락 회피). migrate deploy 로는 안 만들어짐.
  @@index([sourceProvider, status, createdAt, id])
}

model PositionRevision {
  id                    String                 @id @default(uuid())
  positionId            String
  partnerOrganizationId String
  requestedByUserId     String
  status                PositionRevisionStatus @default(PENDING)
  payload               Json
  reviewNote            String?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  position            Position            @relation(fields: [positionId], references: [id], onDelete: Cascade)
  partnerOrganization PartnerOrganization @relation(fields: [partnerOrganizationId], references: [id], onDelete: Cascade)
  requestedByUser     User                @relation("PositionRevisionRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedByUser      User?               @relation("PositionRevisionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([partnerOrganizationId])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@index([status])
  @@index([createdAt])
}

model PositionMatchingParticipant {
  id              String   @id @default(uuid())
  positionId      String
  name            String
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  position  Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("PositionParticipantAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([createdAt])
}

model PositionProgressLog {
  id              String   @id @default(uuid())
  positionId      String
  message         String
  createdByUserId String?
  createdAt       DateTime @default(now())

  position  Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("PositionLogAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([createdAt])
}

model PositionStatusHistory {
  id              String          @id @default(uuid())
  positionId      String
  fromStatus      PositionStatus?
  toStatus        PositionStatus
  note            String?
  createdByUserId String?
  createdAt       DateTime        @default(now())

  position  Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("PositionStatusAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([createdAt])
}

model PartnerApplicantWorkflow {
  id              String   @id @default(uuid())
  partnerUserId   String
  candidateUserId String
  positionId      String
  status          String
  memo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partnerUser   User     @relation("PartnerApplicantWorkflowPartnerUser", fields: [partnerUserId], references: [id], onDelete: Cascade)
  candidateUser User     @relation("PartnerApplicantWorkflowCandidateUser", fields: [candidateUserId], references: [id], onDelete: Cascade)
  position      Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([partnerUserId, candidateUserId, positionId])
  @@index([partnerUserId])
  @@index([candidateUserId])
  @@index([positionId])
}

// 파트너가 인재풀(대표 이력서 동의 학생)을 검색해 먼저 연결을 요청하는 흐름.
// 포지션과 무관한 콜드 연결이라 PartnerApplicantWorkflow(포지션 필수)와 별도.
// 학생이 수락(ACCEPTED)해야 파트너가 연락처를 볼 수 있고 메시지를 주고받는다(동의 기반).
model CandidateConnectionRequest {
  id                    String    @id @default(uuid())
  partnerUserId         String
  partnerOrganizationId String? // 요청 시점 파트너 소속(표시·검증용)
  candidateUserId       String
  status                String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  message               String? // 파트너가 남긴 첫 메시지(선택)
  respondedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  partnerUser   User @relation("CandidateConnPartner", fields: [partnerUserId], references: [id], onDelete: Cascade)
  candidateUser User @relation("CandidateConnCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([partnerUserId, candidateUserId])
  @@index([candidateUserId, status])
  @@index([partnerUserId])
}

model Application {
  id                  String            @id @default(uuid())
  positionId          String
  candidateUserId     String
  // 지원 시점에 연결된 대표 이력서(resume-maker) 참조. 조회는 스냅샷 우선.
  resumeId            String?
  // 지원 시점 서류 스냅샷(제출본 보존) — 지원 후 원본을 수정해도 파트너는 제출 당시
  // 그대로 본다. resumeSnapshot=resume.content 사본, coverLetterSnapshot=자소서 사본.
  resumeSnapshot      Json?
  coverLetterId       String?
  coverLetterSnapshot Json?
  status              ApplicationStatus @default(SUBMITTED)
  memo                String?
  submittedAt         DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  position        Position                   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidateUser   User                       @relation("ApplicationCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)
  resume          Resume?                    @relation("ApplicationResume", fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter     CoverLetter?               @relation("ApplicationCoverLetter", fields: [coverLetterId], references: [id], onDelete: SetNull)
  statusHistories ApplicationStatusHistory[]
  interviewSlots  InterviewSlot[]
  assignments     Assignment[]
  program         Program?
  comments        ApplicationComment[]
  withdrawnAt     DateTime?
  // 자동 넛지 추적 — 회사가 방치한 지원(SUBMITTED) 리마인더, 지원자가 미선택한 면접 리마인더.
  partnerNudgedAt           DateTime?
  applicantInterviewNudgedAt DateTime?

  @@unique([positionId, candidateUserId])
  @@index([positionId])
  @@index([candidateUserId])
  @@index([status])
  @@index([submittedAt])
  @@index([resumeId])
  @@index([coverLetterId])
}

model InterviewSlot {
  id            String              @id @default(uuid())
  applicationId String
  startsAt      DateTime
  endsAt        DateTime
  location      String?
  notes         String?
  status        InterviewSlotStatus @default(PROPOSED)
  proposedAt    DateTime            @default(now())
  selectedAt    DateTime?
  cancelledAt   DateTime?
  reminderSentAt DateTime? // 면접 전날 리마인더 발송 시각(중복 방지)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([startsAt])
  @@index([status])
}

model Assignment {
  id                String           @id @default(uuid())
  applicationId     String
  title             String
  description       String
  dueAt             DateTime?
  status            AssignmentStatus @default(ASSIGNED)
  assignedAt        DateTime         @default(now())
  assignedByUserId  String
  submissionContent String?
  submissionLinks   String[]         @default([])
  submittedAt       DateTime?
  feedbackContent   String?
  feedbackRating    Int?
  reviewedAt        DateTime?
  reviewedByUserId  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assignedBy  User        @relation("AssignmentAssignedBy", fields: [assignedByUserId], references: [id])
  reviewedBy  User?       @relation("AssignmentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([status])
  @@index([dueAt])
}

model Program {
  id            String        @id @default(uuid())
  applicationId String        @unique
  startsAt      DateTime      @default(now())
  endsAt        DateTime?
  status        ProgramStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  application         Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  meetings            ProgramMeeting[]
  feedbacks           ProgramFeedback[]
  certificate         Certificate?
  recommendation      Recommendation?
  schoolCreditRequest SchoolCreditRequest?

  @@index([status])
}

model ProgramMeeting {
  id              String               @id @default(uuid())
  programId       String
  scheduledAt     DateTime
  durationMinutes Int                  @default(30)
  agenda          String?
  notes           String?
  location        String?
  status          ProgramMeetingStatus @default(SCHEDULED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([scheduledAt])
  @@index([status])
}

model ProgramFeedback {
  id           String     @id @default(uuid())
  programId    String
  authorUserId String
  authorRole   MemberRole
  content      String
  rating       Int?
  createdAt    DateTime   @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  author  User    @relation("ProgramFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([authorUserId])
}

// Career Launch(부트캠프) 제출물 단위 코치 피드백. 운영자가 학생의 이력서·자소서를
// 보고 남긴 코멘트를 학생 대시보드로 전달한다. Program/Application 파이프라인과
// 무관하게 학생 userId 로 직접 연결한다.
model CareerLaunchFeedback {
  id            String    @id @default(uuid())
  studentUserId String
  authorUserId  String
  week          Int? // 1~4 주차(선택)
  docType       String // "resume" | "cover_letter" | "general"
  docId         String? // 대상 이력서/자소서 id(선택)
  body          String
  readAt        DateTime? // 학생이 확인한 시각
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student User @relation("CareerLaunchFeedbackStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  author  User @relation("CareerLaunchFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
  @@index([authorUserId])
}

// Career Launch 이력서 데이터. 학생이 별도 이력서 빌더로 가지 않고, 프로그램
// 안에서 AI와 대화하며 기본정보·학력·경력·스킬 등을 대화로 쌓는다. 누적된
// 구조화 데이터(content JSON)를 나중에 이력서 형태로 렌더링한다. 학생당 1개.
model CareerResumeData {
  id            String   @id @default(uuid())
  studentUserId String   @unique
  content       Json     @default("{}") // { basic, educations[], experiences[], skills[], languages[] }
  // 이 career-launch 이력서를 미러링한 실제 aply.global Resume(지원·프로필용) id.
  // 저장 시마다 자동 동기화한다. 느슨한 링크(FK 아님) — Resume 삭제 시 재생성.
  resumeId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student User @relation("CareerResumeDataStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
}

// Career Launch 자기소개서 데이터. 이력서와 마찬가지로 별도 빌더 없이 AI와 대화하며
// 자소서 문항·답변을 쌓는다. content JSON = { company, items:[{question, answer}] }. 학생당 1개.
model CareerCoverLetterData {
  id            String   @id @default(uuid())
  studentUserId String   @unique
  content       Json     @default("{}")
  // 이 career-launch 자소서를 미러링한 실제 aply.global CoverLetter(지원·프로필용) id.
  // 저장 시마다 자동 동기화한다. 느슨한 링크(FK 아님) — CoverLetter 삭제 시 재생성.
  coverLetterId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student User @relation("CareerCoverLetterDataStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
}

// Career Launch 진행 상태. 진단결과·선정직무·정리한 직무정보·완료스텝 등 프로그램
// 진행 상태를 계정 기준으로 저장해, 다른 기기·브라우저에서도 그대로 이어가게 한다.
// (기존 localStorage 를 대체) 학생당 1행, state JSON 블롭.
model CareerLaunchProgress {
  id            String   @id @default(uuid())
  studentUserId String   @unique
  state         Json     @default("{}") // { diagnosis, selectedJobs[], materials[], doneSteps[], interview{practiced[],results{}}, finalFeedback }
  opsMemo       String? // 운영자 내부 메모(학생에게 보이지 않음)
  lastNudgedAt  DateTime? // 마지막 독려 메일 발송 시각
  nudgeCount    Int      @default(0) // 누적 독려 메일 발송 횟수
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student User @relation("CareerLaunchProgressStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
}

// Career Launch 기수(Cohort) — 대학·기수 단위로 운영한다. 등록(CareerEnrollment)된
// 학생만 프로그램에 접근할 수 있고, 운영자가 어드민에서 기수·등록을 관리한다.
model CareerCohort {
  id         String    @id @default(uuid())
  university String // 대학명 (예: 고려대학교)
  name       String // 기수 이름 (예: 2기)
  inviteCode String    @unique // 초대코드 자가등록용
  startsAt   DateTime?
  endsAt     DateTime?
  status     String    @default("active") // active | ended
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  enrollments        CareerEnrollment[]
  employmentOutcomes CareerEmploymentOutcome[]
  satisfactions      CareerLaunchSatisfaction[]
  certificates       CareerLaunchCertificate[]
  seminars           CareerSeminar[]
  weeks              CareerCohortWeek[]

  @@index([status])
}

// Career Launch 기수별 주차 오픈 일정 — 운영자가 각 주차(1~4)의 오픈일을 지정하거나
// 강제 오픈할 수 있다. 학생 주차 게이팅이 이 값을 참조한다.
model CareerCohortWeek {
  id        String    @id @default(uuid())
  cohortId  String
  week      Int // 1~4 주차
  opensAt   DateTime? // 이 시각 이후 자동 오픈(null이면 미지정)
  forceOpen Boolean   @default(false) // 운영자 강제 오픈(날짜 무관 즉시 열림)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  cohort CareerCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, week])
  @@index([cohortId])
}

// Career Launch 세미나 일정 — 기수별·주차별 1건. 운영자가 입력하고 학생 주차 화면에 노출된다.
model CareerSeminar {
  id        String   @id @default(uuid())
  cohortId  String
  week      Int // 1~4 주차
  title     String?
  startsAt  DateTime
  location  String? // 오프라인 장소 또는 안내 문구
  online    Boolean  @default(false)
  url       String? // 온라인 접속 링크(Zoom 등)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohort CareerCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, week])
  @@index([cohortId])
}

// Career Launch 등록 — 학생을 기수에 연결한다. 등록이 있어야 프로그램에 접근 가능.
model CareerEnrollment {
  id            String   @id @default(uuid())
  cohortId      String
  studentUserId String
  createdAt     DateTime @default(now())

  cohort  CareerCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  student User         @relation("CareerEnrollmentStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([cohortId, studentUserId])
  @@index([studentUserId])
}

// Career Launch 취업 성과 — 수료생의 실제 취업 결과를 기록한다.
// aply.global 내부(INTERNAL) 공고뿐 아니라 외부 공고·오프라인 채용까지 모든 경로를 포괄한다
// (외부 공고 지원은 익명 클릭이라 학생별 귀속이 안 되므로, 운영자가 결과를 직접 기록한다).
model CareerEmploymentOutcome {
  id              String                  @id @default(uuid())
  studentUserId   String
  cohortId        String?
  status          EmploymentOutcomeStatus @default(APPLIED)
  companyName     String
  positionTitle   String?
  source          String? // "INTERNAL" | "WANTED" | "BUDDIES" | "EXTERNAL" | "OFFLINE"
  positionId      String? // aply.global 포지션이면 연결(선택)
  note            String?
  decidedAt       DateTime? // 합격/최종 확정 시각
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  student User          @relation("CareerEmploymentOutcomeStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  cohort  CareerCohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@index([studentUserId])
  @@index([cohortId])
  @@index([status])
}

// Career Launch 만족도/추천(NPS) — 수료생이 남기는 프로그램 평가. 학교 리포트의 정성 지표.
model CareerLaunchSatisfaction {
  id            String   @id @default(uuid())
  studentUserId String
  cohortId      String
  rating        Int // 1~5 만족도
  npsScore      Int? // 0~10 추천 점수(NPS)
  comment       String? // 후기/추천사
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student User         @relation("CareerLaunchSatisfactionStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  cohort  CareerCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, studentUserId])
  @@index([cohortId])
}

// Career Launch 수료증 — 기수 단위 프로그램 수료 인증(내부 Program 수료증과 별개).
model CareerLaunchCertificate {
  id             String   @id @default(uuid())
  studentUserId  String
  cohortId       String
  certificateNo  String   @unique
  issuedByUserId String?
  issuedAt       DateTime @default(now())

  student  User          @relation("CareerLaunchCertificateStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  cohort   CareerCohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  issuedBy User?         @relation("CareerLaunchCertificateIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@unique([cohortId, studentUserId])
  @@index([cohortId])
}

enum EmploymentOutcomeStatus {
  APPLIED // 지원
  INTERVIEW // 면접
  OFFER // 합격(오퍼)
  HIRED // 최종 입사
  REJECTED // 불합격
}

model Certificate {
  id             String   @id @default(uuid())
  programId      String   @unique
  title          String
  content        String
  issuedByUserId String
  issuedAt       DateTime @default(now())

  program  Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  issuedBy User    @relation("CertificateIssuer", fields: [issuedByUserId], references: [id])

  @@index([programId])
}

model Recommendation {
  id             String   @id @default(uuid())
  programId      String   @unique
  content        String
  signerName     String
  signerTitle    String?
  issuedByUserId String
  issuedAt       DateTime @default(now())

  program  Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  issuedBy User    @relation("RecommendationIssuer", fields: [issuedByUserId], references: [id])

  @@index([programId])
}

model SchoolCreditRequest {
  id               String             @id @default(uuid())
  programId        String             @unique
  schoolName       String
  courseCode       String?
  credits          Int                @default(0)
  status           SchoolCreditStatus @default(REQUESTED)
  requestedAt      DateTime           @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewNote       String?

  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("SchoolCreditReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([status])
}

model ApplicationStatusHistory {
  id              String            @id @default(uuid())
  applicationId   String
  status          ApplicationStatus
  changedByUserId String?
  memo            String?
  changedAt       DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("ApplicationStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([changedByUserId])
}

model IssueReport {
  id               String            @id @default(uuid())
  type             IssueReportType
  status           IssueReportStatus @default(OPEN)
  title            String
  description      String
  reporterUserId   String
  subjectUserId    String?
  positionId       String?
  applicationId    String?
  assignedToUserId String?
  resolutionNote   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  resolvedAt       DateTime?

  reporter   User  @relation("IssueReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  subject    User? @relation("IssueReportSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("IssueReportAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([reporterUserId])
  @@index([assignedToUserId])
  @@index([createdAt])
}

model Notification {
  id            String    @id @default(uuid())
  userId        String
  type          String
  title         String
  message       String?
  linkPath      String?
  // 연관 지원 건(있으면) — 지원 카드별 '안 읽은 메시지' 뱃지 계산·읽음 처리에 사용.
  applicationId String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, applicationId, readAt])
}

model ApplicationComment {
  id            String                       @id @default(uuid())
  applicationId String
  authorUserId  String
  authorRole    MemberRole
  content       String
  visibility    ApplicationCommentVisibility @default(INTERNAL)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation("ApplicationCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([authorUserId])
  @@index([createdAt])
}

model AuditLog {
  id          String      @id @default(uuid())
  actorUserId String?
  actorRole   MemberRole?
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([actorUserId, createdAt])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
}

model Announcement {
  id              String               @id @default(uuid())
  title           String
  body            String
  severity        AnnouncementSeverity @default(INFO)
  audience        AnnouncementAudience @default(ALL)
  linkPath        String?
  active          Boolean              @default(true)
  startsAt        DateTime             @default(now())
  endsAt          DateTime?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([active, audience])
  @@index([startsAt])
}

model AppSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model MatchingRunHistory {
  id             String   @id @default(uuid())
  mode           String
  source         String?
  positionId     String?
  candidateId    String?
  positionTitle  String?
  candidateLabel String?
  resultCount    Int      @default(0)
  results        Json
  ranAt          DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([mode])
  @@index([positionId])
  @@index([candidateId])
}

model CandidateProfile {
  id                       String                       @id @default(uuid())
  userId                   String                       @unique
  workPermit               Boolean?
  visaType                 CandidateVisaType?
  visaExpiryDate           DateTime?
  livesInKorea             Boolean?
  hasAccommodation         Boolean?
  residenceProvince        String?
  residenceDistrict        String?
  residenceAddress         String?
  preferredProgramDuration CandidateProgramDuration?
  programStartOption       CandidateProgramStartOption?
  programStartDate         DateTime?
  preferredIndustries      PartnerIndustry[]            @default([])
  preferredJobRoles        CandidatePreferredJobRole[]  @default([])
  favoritePositionIds      String[]                     @default([])
  appliedPositionIds       String[]                     @default([])
  // 관심 회사(팔로우) — 리뉴얼은 회사를 이름으로 식별하므로 이름 목록으로 보관.
  followedCompanyNames     String[]                     @default([])
  skills                   String[]                     @default([])
  selfIntroduction         String?
  programMotivation        String?
  preferenceConditionNote  String?
  capabilityNote           String?
  additionalInfoNote       String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  emergencyContactEmail    String?
  emergencyContactAddress  String?
  matchingResultNote       String?
  resumeUrl                String?
  resumeFileName           String?
  coverLetterUrl           String?
  coverLetterFileName      String?
  portfolioUrl             String?
  portfolioFileName        String?
  passportImageUrl         String?
  passportImageFileName    String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  user                User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations          CandidateEducation[]
  languageSkills      CandidateLanguageSkill[]
  careers             CandidateCareer[]
  activityExperiences CandidateActivityExperience[]

  @@index([visaType])
  @@index([livesInKorea])
}

model CandidateCareer {
  id                 String    @id @default(uuid())
  candidateProfileId String
  companyName        String
  position           String
  department         String?
  isCurrent          Boolean   @default(false)
  startDate          DateTime?
  endDate            DateTime?
  description        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@index([isCurrent])
}

model CandidateEducation {
  id                 String                   @id @default(uuid())
  candidateProfileId String
  schoolName         String
  educationType      CandidateEducationType
  major              String?
  status             CandidateEducationStatus
  country            String?
  city               String?
  startDate          DateTime?
  endDate            DateTime?
  isKoreanSchool     Boolean?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@index([educationType])
  @@index([status])
}

model CandidateLanguageSkill {
  id                 String                 @id @default(uuid())
  candidateProfileId String
  language           CandidateLanguageType
  level              CandidateLanguageLevel
  testName           String?
  score              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@index([language])
  @@index([level])
}

model CandidateActivityExperience {
  id                 String                @id @default(uuid())
  candidateProfileId String
  title              String
  activityType       CandidateActivityType
  organization       String?
  startDate          DateTime?
  endDate            DateTime?
  description        String?
  skills             String[]              @default([])
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@index([activityType])
}

// A user-authored Korean-style resume. Users can keep multiple versions
// (e.g. one per target role). The structured fields live in `content` as
// JSON so the builder can evolve without a migration per field.
model Resume {
  id           String   @id @default(uuid())
  userId       String
  title        String
  content      Json     @default("{}")
  isPrimary    Boolean  @default(false)
  // Public share slug — anyone with the link can view a read-only single-
  // page rendering of this resume without signing in. We mint a fresh cuid
  // on row insert; old rows get one backfilled by the migration so the
  // column can stay NOT NULL + unique.
  shareSlug    String   @unique @default(cuid())
  // Per-locale translation cache. Same idea as Position.translations.
  // Shape: { ko: { summary, selfIntroduction, careers: [{ description }], activities: [{ description }] } }
  // Filled on save whenever a long-form field is detected as non-Korean.
  // Existing rows stay null until the next edit; readers must handle absence.
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sgcApplications SgcApplication[] @relation("SgcApplicationResume")
  applications    Application[]    @relation("ApplicationResume")

  @@index([userId])
}

// 한국형 자기소개서(자소서) — 이력서와 별개 컬렉션. 회사/공고마다 다르게 제출하므로
// 지원 건(회사)당 한 행으로 둔다. resumeId 로 근거 이력서를 느슨하게 연결(FK 아님,
// 이력서가 지워져도 자소서는 남는다 — 코드에서 부재를 처리). items = [{id,prompt,answer}].
model CoverLetter {
  id        String   @id @default(uuid())
  userId    String
  title     String // 식별 라벨(예: "삼성전자 — 마케팅")
  company   String? // 지원 회사명(선택, AI 컨텍스트 + 미리보기 헤더)
  resumeId  String? // 근거/연결 이력서(선택)
  items     Json     @default("[]")
  // 공개 공유 slug — 이력서(Resume.shareSlug)와 동일. 링크만 있으면 로그인 없이
  // 읽기 전용으로 열람. 신규 행은 cuid 자동 생성, 기존 행은 마이그레이션에서 backfill.
  shareSlug String   @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[] @relation("ApplicationCoverLetter")

  @@index([userId])
}

// 공고별 모의 면접 연습 기록 — (userId, positionId) 당 한 행. 회사엔 "완료" 신호만,
// 점수/답변은 지원자 전용(비공개).
model MockInterviewSession {
  id              String   @id @default(uuid())
  userId          String
  positionId      String
  answeredCount   Int      @default(0)
  bestScore       Int?
  lastPracticedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, positionId])
  @@index([positionId])
}

// 파트너용 지원 서류 LLM 불렛 요약 캐시.
// version = 대표 이력서 updatedAt(ms). 이력서/자소서가 바뀌면 version 이 달라져 재생성한다.
model ApplicantDocSummary {
  id              String   @id @default(uuid())
  candidateUserId String   @unique
  version         String
  resumeBullets   String[] @default([])
  coverBullets    String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 프리미엄 한도 — 비싼/반복형 AI 기능(공고 맞춤 분석, 모의 면접 평가)의 월 사용량.
// periodKey 는 KST 기준 "YYYY-MM". (userId, feature, periodKey) 당 한 행으로 카운트.
// 공용 AI 티켓 지갑(잔액) — 가입 시 1회 보너스 + 매일 일정량 적립(상한). 사용 시 차감.
model AiWallet {
  userId       String   @id
  balance      Int      @default(0)
  lastGrantDay Int      @default(0) // KST 기준 epoch-day 인덱스(마지막 적립일)
  welcomed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// AI 티켓 쿠폰 — 코드로 1회성(또는 제한 횟수) 충전. 사용자당 같은 코드는 한 번만.
model Coupon {
  id        String    @id @default(uuid())
  code      String    @unique // 대문자/공백 정규화해 저장
  tickets   Int // 충전될 티켓 수
  maxUses   Int       @default(1) // 코드별 전체 사용 가능 횟수
  usedCount Int       @default(0)
  // 같은 그룹(이벤트)의 여러 코드 중 계정당 1개만 등록 가능하게 묶는 키(없으면 코드 단독).
  groupKey  String?
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  redemptions CouponRedemption[]

  @@index([groupKey])
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  tickets   Int
  groupKey  String? // 충전 시점의 쿠폰 그룹(그룹당 계정 1회 유니크 제약용)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@unique([groupKey, userId]) // 그룹당 계정 1회(groupKey null 은 다중 허용)
  @@index([userId])
}

model AiUsage {
  id        String   @id @default(uuid())
  userId    String
  feature   String // "tailor_analyze" | "interview_feedback"
  periodKey String // KST 기준 "YYYY-MM"
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, periodKey])
  @@index([userId])
}

model CommunityPost {
  id         String                @id @default(uuid())
  authorId   String?
  authorName String
  category   CommunityPostCategory
  title      String
  body       String
  imageUrls  String[]              @default([])
  likes      Int                   @default(0)
  comments   Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  author       User?                  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  likedBy      CommunityPostLike[]
  commentItems CommunityPostComment[]

  @@index([category])
  @@index([createdAt])
}

model CommunityPostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

model CommunityPostComment {
  id         String   @id @default(uuid())
  postId     String
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
}

model CompanyConsultationInquiry {
  id          String   @id @default(uuid())
  companyName String
  contactName String
  email       String
  phone       String?
  message     String
  locale      String   @default("ko")
  source      String   @default("platform-web")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

// Hanpass × Aply 이벤트 — 문자 링크로 들어온 한패스 이용자의 취업 지원 설문.
// 익명 공개 제출(비로그인). 선착순 첨삭/컨설팅 안내는 운영팀이 수동 처리.
model HanpassSurveyResponse {
  id               String   @id @default(uuid())
  name             String
  phone            String
  email            String
  jobIntent        String // 구직/이직 의향 코드
  availableFrom    String // 근무 가능 시점 코드
  jobFields        String[] @default([]) // 희망 일자리 분야 (복수)
  jobFieldOther    String?
  visaType         String // 비자 종류 코드
  wantsConsulting  String // 이력서 첨삭·컨설팅 신청 여부 코드
  consultLanguages String[] @default([]) // 상담 가능 언어 (복수)
  privacyConsent   Boolean  @default(false)
  locale           String   @default("ko")
  source           String   @default("hanpass")
  ipHash           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([createdAt])
  @@index([email])
  @@index([phone])
}

// Viral landing — oh-haeng (five-element) saju prediction. We persist
// the LLM result keyed by a short id so the user can share / revisit
// the result and so the post-signup redirect can look it back up.
// userId is filled in once the visitor signs up (if ever); the row is
// otherwise anonymous.
model SajuPrediction {
  id                     String    @id @default(uuid())
  name                   String
  gender                 String
  birthDate              DateTime
  birthTime              String?
  calendarType           String    @default("solar")
  interpretation         String
  details                Json?
  translations           Json?
  recommendedRoleNames   String[]
  recommendedPositionIds String[]
  shareSlug              String    @unique @default(cuid())
  inputHash              String?   @unique
  userId                 String?
  ipHash                 String?
  locale                 String    @default("ko")
  createdAt              DateTime  @default(now())
  claimedAt              DateTime?

  leads SajuLead[]

  @@index([userId])
  @@index([createdAt])
}

// "Profile Pool" — career info collected AFTER the (free) saju result,
// before signup. One lead per prediction (a person can refine theirs). The
// prediction itself is the "Raw Pool"; this row promotes them to the
// Profile Pool. userId is filled once they sign up (claim flow), at which
// point poolStage moves toward VERIFIED / RECOMMENDABLE.
model SajuLead {
  id               String   @id @default(uuid())
  predictionId     String?
  shareSlug        String?
  name             String?
  // Career info captured pre-signup (kept as strings for funnel flexibility;
  // enum values mirror the Candidate* enums where applicable).
  nationality      String?
  school           String?
  major            String?
  visaType         String?
  koreanLevel      String?
  englishLevel     String?
  preferredJobRole String?
  workType         String?
  contact          String?
  contactType      String?
  hasResume        Boolean?
  // Rule-based recommendation snapshot (no LLM cost) shown back to the user
  // and surfaced to ops so the funnel result is auditable.
  recommendedRoles String[] @default([])
  improvements     String[] @default([])
  recommendStatus  String?
  // Pool classification + auto-generated filter tags (nationality / role /
  // visa / language / work type).
  poolStage        String   @default("PROFILE")
  tags             String[] @default([])
  // Consent is split by purpose (career-info collection vs. employer
  // referral) per the privacy design.
  consentCareer    Boolean  @default(false)
  consentRecommend Boolean  @default(false)
  // Opt-in to be contacted later (email / messenger) and to have the info
  // used for follow-up. Required before any outreach from the ops Pool.
  consentContact   Boolean  @default(false)
  userId           String?
  locale           String   @default("ko")
  ipHash           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prediction SajuPrediction? @relation(fields: [predictionId], references: [id], onDelete: SetNull)

  @@index([predictionId])
  @@index([userId])
  @@index([poolStage])
  @@index([createdAt])
}

// CrawlerRun — one row per execution of the external crawl runner. The
// scheduler logs daily KST 00:00 runs; manual /ops/crawlers/run* triggers
// are tagged 'manual'. We keep the per-source CrawlerRunSummary as JSON so
// the schema doesn't need to know the shape (it's a moving target as
// scrapers change).
model CrawlerRun {
  id            String    @id @default(uuid())
  source        String // "all" | "buddies" | "wanted"
  triggeredBy   String    @default("manual") // "scheduler" | "manual"
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  elapsedMs     Int       @default(0)
  ok            Boolean   @default(false)
  errorMessage  String?
  buddiesResult Json?
  wantedResult  Json?

  @@index([startedAt])
  @@index([source])
  @@index([ok])
}

// MBTI × 한국 직장 매칭 이벤트 — viral lead-gen following the saju pattern.
// Anonymous prediction is generated client-side and persisted with a share
// slug so the result page can be opened by anyone and shared on socials.
// userId is set once a visitor signs up post-result (claim flow).
model MbtiPrediction {
  id                     String    @id @default(uuid())
  mbtiType               String // e.g. "ENTJ", "ISFP"
  name                   String?
  nationality            String?
  recommendedRoleNames   String[]
  recommendedPositionIds String[]
  cultureSummary         String    @default("")
  interpretation         String    @default("")
  shareSlug              String    @unique @default(cuid())
  userId                 String?
  ipHash                 String?
  locale                 String    @default("ko")
  createdAt              DateTime  @default(now())
  claimedAt              DateTime?

  @@index([userId])
  @@index([createdAt])
  @@index([mbtiType])
}

// 비자 가능성 체크 이벤트 — rule-based eligibility hint. NOT legal advice;
// the result page must surface that disclaimer prominently.
model VisaCheckResult {
  id                     String    @id @default(uuid())
  name                   String?
  nationality            String
  currentVisa            String? // current visa code (e.g. "D-2") if any
  educationLevel         String // "HIGH_SCHOOL" | "BACHELOR" | "MASTER" | "PHD"
  majorCategory          String? // "IT" | "BUSINESS" | "HUMANITIES" | ...
  koreanLevel            String // "NONE" | "BEGINNER" | "INTERMEDIATE" | "ADVANCED" | "NATIVE"
  workYears              Int       @default(0)
  targetRole             String?
  // Phase 1 신규 입력 — 결과 페이지의 5단계 상태 분류 + 로드맵 우선순위에
  // 사용된다. JSON 안이 아닌 top-level 컬럼으로 둬서 운영 콘솔의 raw-pool
  // 필터링/정렬을 가능하게 한다.
  inKorea                Boolean?
  hasJobOffer            Boolean?
  graduationStatus       String? // "not_applicable" | "completed" | "within_6mo" | "within_1y" | "later"
  // wrapper: { visas, roadmap, nextSteps, inputContext } (legacy: bare array)
  eligibleVisas          Json
  recommendedPositionIds String[]
  shareSlug              String    @unique @default(cuid())
  userId                 String?
  ipHash                 String?
  locale                 String    @default("ko")
  createdAt              DateTime  @default(now())
  claimedAt              DateTime?

  leads VisaLead[]

  @@index([userId])
  @@index([createdAt])
  @@index([nationality])
  @@index([currentVisa])
  @@index([graduationStatus])
}

// VisaLead — 결과 페이지의 회원가입 퍼널에서 모은 익명 리드. SajuLead 와
// 같은 패턴 (pool 화 + ops 검토용) 으로, 외국인 채용 funnel 에 특화된 필드
// (희망 입사일·졸업일·현재 비자) 를 더한 형태. 익명 단계에 모았다가 사용자
// 가 가입하면 userId 가 채워지며 회원과 자동 연결.
model VisaLead {
  id               String   @id @default(uuid())
  visaResultId     String?
  shareSlug        String?
  name             String?
  // 연락 채널 — 이메일 또는 전화번호. contactType 으로 구분.
  contact          String?
  contactType      String? // "email" | "phone" | "messenger"
  // 결과 페이지에서 한 번 더 확인/보완하는 funnel 필드.
  nationality      String?
  currentVisa      String?
  expectedJoinDate String? // 희망 입사일 ("YYYY-MM" 자유 입력)
  graduationDate   String? // 대학 졸업일 ("YYYY-MM")
  university       String?
  major            String?
  preferredJobRole String?
  koreanLevel      String?
  englishLevel     String?
  // pool classification + 자동 태그 (국적 / 직무 / 비자 / 언어 등).
  poolStage        String   @default("PROFILE")
  tags             String[] @default([])
  // 동의 분기 — saju 와 동일한 3-purpose 모델.
  consentCareer    Boolean  @default(false)
  consentRecommend Boolean  @default(false)
  consentContact   Boolean  @default(false)
  userId           String?
  locale           String   @default("ko")
  ipHash           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  visaResult VisaCheckResult? @relation(fields: [visaResultId], references: [id], onDelete: SetNull)

  @@index([visaResultId])
  @@index([userId])
  @@index([poolStage])
  @@index([createdAt])
}

// 서울글로벌센터 × Aply 협력 6주 일경험 프로그램 지원. Aply 회원만 지원
// 가능(이력서 기반) — anonymous 신청은 받지 않고, 사용자 본인 이력서 1개를
// 묶어 운영팀에 전달. 한 사용자당 1회 지원으로 중복 방지.
model SgcApplication {
  id                 String  @id @default(uuid())
  userId             String
  // 지원자 본인 이력서 1개 — 운영팀이 ops 콘솔에서 자동 연결해 검토.
  // 이력서가 삭제돼도 지원 row 는 남도록 Restrict (운영 기록 보존).
  resumeId           String
  // 신청자 직접 입력 (SGC 공식 포스터 폼). 프로필/이력서에서 prefill 하되
  // 제출값은 지원서에 독립 저장한다. 기존 row 호환 위해 전부 nullable —
  // 필수 여부는 API zod 레벨에서 강제한다.
  applicantName      String? // 이름 (본명 / 한국어명)
  birthDate          String? // 생년월일 "YYYY-MM-DD"
  gender             String? // "FEMALE" | "MALE"
  nationality        String? // 국적 (한국어 작성)
  university         String? // 대학교 이름
  major              String? // 전공 학과
  grade              String? // "UNDERGRAD_4" | "GRAD" | "GRADUATED"
  expectedGraduation String? // 졸업 예정일 (예: "2026년 8월")
  koreaStayDuration  String? // "LT_1Y" | "Y1_2" | "Y2_3" | "Y3_5" | "GTE_5Y"
  address            String? // 주소 (예: "서울시 종로구")
  email              String? // 이메일 주소
  phone              String? // 휴대폰 번호
  referralSource     String? // 알게된 경로 (enum key, 아래 참조)
  referralOther      String? // 경로 "기타" 또는 인터넷 검색명
  topikLevel         String? // "4" | "5" | "6"
  topikCertUrl       String? // TOPIK 성적증명서 업로드 (blob URL / data URL)

  visaType           String // "D-2" | "D-10" | "OTHER"
  visaOther          String?
  healthNote         String // 지병 / 알러지 / 식습관 등 자유 입력
  // 취업 희망 직무 — 다중 선택. "DEV" | "MARKETING" | "SALES" | "OTHER".
  desiredJobs        String[] @default([])
  desiredJob         String? // legacy 단일 (구버전 호환, 신규는 desiredJobs 사용)
  desiredJobOther    String?
  motivation         String // 신청 동기 장문
  // 동의 분기 — 마케팅(선택)은 raw flag, 개인정보(필수)는 항상 true 만 저장.
  marketingOptIn     Boolean  @default(false)
  privacyConsent     Boolean  @default(true)
  // 사전 교육(최종 합격자 익일, 6/30) 필수 참여 동의 — 신규 폼 필드. 기존
  // row 호환 위해 nullable (null = 동의 항목 도입 전 지원, true = 동의함).
  preTrainingConsent Boolean?
  // 운영 단계 — SUBMITTED → INTERVIEW → ACCEPTED / REJECTED / WITHDRAWN
  status             String   @default("SUBMITTED")
  // 운영 메모 (operator only)
  adminMemo          String?
  ipHash             String?
  locale             String   @default("ko")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User   @relation("SgcApplicationUser", fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation("SgcApplicationResume", fields: [resumeId], references: [id], onDelete: Restrict)

  @@unique([userId])
  @@index([status])
  @@index([createdAt])
  @@index([resumeId])
}
