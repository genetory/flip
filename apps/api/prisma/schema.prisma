model CompanyConsultationInquiry {
  id          String   @id @default(uuid())
  companyName String
  contactName String
  email       String
  phone       String?
  message     String
  locale      String   @default("ko")
  source      String   @default("platform-web")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

// Hanpass × Aply 이벤트 — 문자 링크로 들어온 한패스 이용자의 취업 지원 설문.
// 익명 공개 제출(비로그인). 선착순 첨삭/컨설팅 안내는 운영팀이 수동 처리.
model HanpassSurveyResponse {
  id               String   @id @default(uuid())
  name             String
  phone            String
  email            String
  jobIntent        String // 구직/이직 의향 코드
  availableFrom    String // 근무 가능 시점 코드
  jobFields        String[] @default([]) // 희망 일자리 분야 (복수)
  jobFieldOther    String?
  visaType         String // 비자 종류 코드
  wantsConsulting  String // 이력서 첨삭·컨설팅 신청 여부 코드
  consultLanguages String[] @default([]) // 상담 가능 언어 (복수)
  privacyConsent   Boolean  @default(false)
  locale           String   @default("ko")
  source           String   @default("hanpass")
  ipHash           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([createdAt])
  @@index([email])
  @@index([phone])
}

// Viral landing — oh-haeng (five-element) saju prediction. We persist
// the LLM result keyed by a short id so the user can share / revisit
// the result and so the post-signup redirect can look it back up.
// userId is filled in once the visitor signs up (if ever); the row is
// otherwise anonymous.
model SajuPrediction {
  id                     String    @id @default(uuid())
  name                   String
  gender                 String
  birthDate              DateTime
  birthTime              String?
  calendarType           String    @default("solar")
  interpretation         String
  details                Json?
  translations           Json?
  recommendedRoleNames   String[]
  recommendedPositionIds String[]
  shareSlug              String    @unique @default(cuid())
  inputHash              String?   @unique
  userId                 String?
  ipHash                 String?
  locale                 String    @default("ko")
  createdAt              DateTime  @default(now())
  claimedAt              DateTime?

  leads SajuLead[]

  @@index([userId])
  @@index([createdAt])
}

// "Profile Pool" — career info collected AFTER the (free) saju result,
// before signup. One lead per prediction (a person can refine theirs). The
// prediction itself is the "Raw Pool"; this row promotes them to the
// Profile Pool. userId is filled once they sign up (claim flow), at which
// point poolStage moves toward VERIFIED / RECOMMENDABLE.
model SajuLead {
  id               String   @id @default(uuid())
  predictionId     String?
  shareSlug        String?
  name             String?
  // Career info captured pre-signup (kept as strings for funnel flexibility;
  // enum values mirror the Candidate* enums where applicable).
  nationality      String?
  school           String?
  major            String?
  visaType         String?
  koreanLevel      String?
  englishLevel     String?
  preferredJobRole String?
  workType         String?
  contact          String?
  contactType      String?
  hasResume        Boolean?
  // Rule-based recommendation snapshot (no LLM cost) shown back to the user
  // and surfaced to ops so the funnel result is auditable.
  recommendedRoles String[] @default([])
  improvements     String[] @default([])
  recommendStatus  String?
  // Pool classification + auto-generated filter tags (nationality / role /
  // visa / language / work type).
  poolStage        String   @default("PROFILE")
  tags             String[] @default([])
  // Consent is split by purpose (career-info collection vs. employer
  // referral) per the privacy design.
  consentCareer    Boolean  @default(false)
  consentRecommend Boolean  @default(false)
  // Opt-in to be contacted later (email / messenger) and to have the info
  // used for follow-up. Required before any outreach from the ops Pool.
  consentContact   Boolean  @default(false)
  userId           String?
  locale           String   @default("ko")
  ipHash           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prediction SajuPrediction? @relation(fields: [predictionId], references: [id], onDelete: SetNull)

  @@index([predictionId])
  @@index([userId])
  @@index([poolStage])
  @@index([createdAt])
}

// CrawlerRun — one row per execution of the external crawl runner. The
// scheduler logs daily KST 00:00 runs; manual /ops/crawlers/run* triggers
// are tagged 'manual'. We keep the per-source CrawlerRunSummary as JSON so
// the schema doesn't need to know the shape (it's a moving target as
// scrapers change).
model CrawlerRun {
  id            String    @id @default(uuid())
  source        String // "all" | "buddies" | "wanted"
  triggeredBy   String    @default("manual") // "scheduler" | "manual"
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  elapsedMs     Int       @default(0)
  ok            Boolean   @default(false)
  errorMessage  String?
  buddiesResult Json?
  wantedResult  Json?

  @@index([startedAt])
  @@index([source])
  @@index([ok])
}

// MBTI × 한국 직장 매칭 이벤트 — viral lead-gen following the saju pattern.
// Anonymous prediction is generated client-side and persisted with a share
// slug so the result page can be opened by anyone and shared on socials.
// userId is set once a visitor signs up post-result (claim flow).
model MbtiPrediction {
  id                     String    @id @default(uuid())
  mbtiType               String // e.g. "ENTJ", "ISFP"
  name                   String?
  nationality            String?
  recommendedRoleNames   String[]
  recommendedPositionIds String[]
  cultureSummary         String    @default("")
  interpretation         String    @default("")
  shareSlug              String    @unique @default(cuid())
  userId                 String?
  ipHash                 String?
  locale                 String    @default("ko")
  createdAt              DateTime  @default(now())
  claimedAt              DateTime?

  @@index([userId])
  @@index([createdAt])
  @@index([mbtiType])
}

// 비자 가능성 체크 이벤트 — rule-based eligibility hint. NOT legal advice;
// the result page must surface that disclaimer prominently.
model VisaCheckResult {
  id                     String    @id @default(uuid())
  name                   String?
  nationality            String
  currentVisa            String? // current visa code (e.g. "D-2") if any
  educationLevel         String // "HIGH_SCHOOL" | "BACHELOR" | "MASTER" | "PHD"
  majorCategory          String? // "IT" | "BUSINESS" | "HUMANITIES" | ...
  koreanLevel            String // "NONE" | "BEGINNER" | "INTERMEDIATE" | "ADVANCED" | "NATIVE"
  workYears              Int       @default(0)
  targetRole             String?
  // Phase 1 신규 입력 — 결과 페이지의 5단계 상태 분류 + 로드맵 우선순위에
  // 사용된다. JSON 안이 아닌 top-level 컬럼으로 둬서 운영 콘솔의 raw-pool
  // 필터링/정렬을 가능하게 한다.
  inKorea                Boolean?
  hasJobOffer            Boolean?
  graduationStatus       String? // "not_applicable" | "completed" | "within_6mo" | "within_1y" | "later"
  // wrapper: { visas, roadmap, nextSteps, inputContext } (legacy: bare array)
  eligibleVisas          Json
  recommendedPositionIds String[]
  shareSlug              String    @unique @default(cuid())
  userId                 String?
  ipHash                 String?
  locale                 String    @default("ko")
  createdAt              DateTime  @default(now())
  claimedAt              DateTime?

  leads VisaLead[]

  @@index([userId])
  @@index([createdAt])
  @@index([nationality])
  @@index([currentVisa])
  @@index([graduationStatus])
}

// VisaLead — 결과 페이지의 회원가입 퍼널에서 모은 익명 리드. SajuLead 와
// 같은 패턴 (pool 화 + ops 검토용) 으로, 외국인 채용 funnel 에 특화된 필드
// (희망 입사일·졸업일·현재 비자) 를 더한 형태. 익명 단계에 모았다가 사용자
// 가 가입하면 userId 가 채워지며 회원과 자동 연결.
model VisaLead {
  id               String   @id @default(uuid())
  visaResultId     String?
  shareSlug        String?
  name             String?
  // 연락 채널 — 이메일 또는 전화번호. contactType 으로 구분.
  contact          String?
  contactType      String? // "email" | "phone" | "messenger"
  // 결과 페이지에서 한 번 더 확인/보완하는 funnel 필드.
  nationality      String?
  currentVisa      String?
  expectedJoinDate String? // 희망 입사일 ("YYYY-MM" 자유 입력)
  graduationDate   String? // 대학 졸업일 ("YYYY-MM")
  university       String?
  major            String?
  preferredJobRole String?
  koreanLevel      String?
  englishLevel     String?
  // pool classification + 자동 태그 (국적 / 직무 / 비자 / 언어 등).
  poolStage        String   @default("PROFILE")
  tags             String[] @default([])
  // 동의 분기 — saju 와 동일한 3-purpose 모델.
  consentCareer    Boolean  @default(false)
  consentRecommend Boolean  @default(false)
  consentContact   Boolean  @default(false)
  userId           String?
  locale           String   @default("ko")
  ipHash           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  visaResult VisaCheckResult? @relation(fields: [visaResultId], references: [id], onDelete: SetNull)

  @@index([visaResultId])
  @@index([userId])
  @@index([poolStage])
  @@index([createdAt])
}

// 서울글로벌센터 × Aply 협력 6주 일경험 프로그램 지원. Aply 회원만 지원
// 가능(이력서 기반) — anonymous 신청은 받지 않고, 사용자 본인 이력서 1개를
// 묶어 운영팀에 전달. 한 사용자당 1회 지원으로 중복 방지.
model SgcApplication {
  id                 String  @id @default(uuid())
  userId             String
  // 지원자 본인 이력서 1개 — 운영팀이 ops 콘솔에서 자동 연결해 검토.
  // 이력서가 삭제돼도 지원 row 는 남도록 Restrict (운영 기록 보존).
  resumeId           String
  // 신청자 직접 입력 (SGC 공식 포스터 폼). 프로필/이력서에서 prefill 하되
  // 제출값은 지원서에 독립 저장한다. 기존 row 호환 위해 전부 nullable —
  // 필수 여부는 API zod 레벨에서 강제한다.
  applicantName      String? // 이름 (본명 / 한국어명)
  birthDate          String? // 생년월일 "YYYY-MM-DD"
  gender             String? // "FEMALE" | "MALE"
  nationality        String? // 국적 (한국어 작성)
  university         String? // 대학교 이름
  major              String? // 전공 학과
  grade              String? // "UNDERGRAD_4" | "GRAD" | "GRADUATED"
  expectedGraduation String? // 졸업 예정일 (예: "2026년 8월")
  koreaStayDuration  String? // "LT_1Y" | "Y1_2" | "Y2_3" | "Y3_5" | "GTE_5Y"
  address            String? // 주소 (예: "서울시 종로구")
  email              String? // 이메일 주소
  phone              String? // 휴대폰 번호
  referralSource     String? // 알게된 경로 (enum key, 아래 참조)
  referralOther      String? // 경로 "기타" 또는 인터넷 검색명
  topikLevel         String? // "4" | "5" | "6"
  topikCertUrl       String? // TOPIK 성적증명서 업로드 (blob URL / data URL)

  visaType           String // "D-2" | "D-10" | "OTHER"
  visaOther          String?
  healthNote         String // 지병 / 알러지 / 식습관 등 자유 입력
  // 취업 희망 직무 — 다중 선택. "DEV" | "MARKETING" | "SALES" | "OTHER".
  desiredJobs        String[] @default([])
  desiredJob         String? // legacy 단일 (구버전 호환, 신규는 desiredJobs 사용)
  desiredJobOther    String?
  motivation         String // 신청 동기 장문
  // 동의 분기 — 마케팅(선택)은 raw flag, 개인정보(필수)는 항상 true 만 저장.
  marketingOptIn     Boolean  @default(false)
  privacyConsent     Boolean  @default(true)
  // 사전 교육(최종 합격자 익일, 6/30) 필수 참여 동의 — 신규 폼 필드. 기존
  // row 호환 위해 nullable (null = 동의 항목 도입 전 지원, true = 동의함).
  preTrainingConsent Boolean?
  // 운영 단계 — SUBMITTED → INTERVIEW → ACCEPTED / REJECTED / WITHDRAWN
  status             String   @default("SUBMITTED")
  // 운영 메모 (operator only)
  adminMemo          String?
  ipHash             String?
  locale             String   @default("ko")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User   @relation("SgcApplicationUser", fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation("SgcApplicationResume", fields: [resumeId], references: [id], onDelete: Restrict)

  @@unique([userId])
  @@index([status])
  @@index([createdAt])
  @@index([resumeId])
}

// Talent 행동 이벤트 스트림 — Passport·매칭 학습·퍼널 분석의 원장(History).
// GA 전송과 별개로 DB에 남겨 "어떤 행동을 한 Talent가 실제 채용됐는가"를 분석한다.
// 순수 가산(append-only) — 기존 기능 무영향.
model TalentEvent {
  id           String   @id @default(uuid())
  talentUserId String
  actorType    String   @default("talent") // talent | company | university | system
  eventType    String // career_diagnosis_completed, resume_created, position_applied, interview_invited, hired ...
  entityType   String? // position | application | connection | outcome | resume | interview
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  talentUser User @relation("TalentEventUser", fields: [talentUserId], references: [id], onDelete: Cascade)

  @@index([talentUserId, createdAt])
  @@index([eventType, createdAt])
}
