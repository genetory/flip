  SIZE_UNDER_30
  SIZE_UNDER_50
  SIZE_OVER_100
}

enum PositionStatus {
  DRAFT
  PENDING_REVIEW
  OPEN
  PAUSED
  CLOSED
  REJECTED
}

enum PositionRevisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationCommentVisibility {
  INTERNAL
  CANDIDATE
}

enum AnnouncementSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum AnnouncementAudience {
  ALL
  STUDENT
  PARTNER
  OPERATOR
}

enum ApplicationStatus {
  WITHDRAWN
  SUBMITTED
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum IssueReportType {
  NO_SHOW
  BEHAVIOR
  DROPOUT
  ATTITUDE
  PAYMENT
  OTHER
}

enum IssueReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum InterviewSlotStatus {
  PROPOSED
  SELECTED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  SUBMITTED
  REVIEWED
  CANCELLED
}

enum ProgramStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProgramMeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SchoolCreditStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum PositionEmploymentType {
  FULL_TIME
  INTERN
  PART_TIME
  UNPAID_INTERN
}

enum PositionSourceKind {
  INTERNAL
  EXTERNAL
}

enum PositionSourceProvider {
  INTERNAL
  BUDDIES
  KOWORK
  WANTED
  OTHER
}

enum CandidateVisaType {
  D10_JOB_SEEKING
  D2_STUDENT
  D4_GENERAL_TRAINING
  F2_RESIDENCE
  F4_OVERSEAS_KOREAN
  F5_PERMANENT_RESIDENCE
  F6_MARRIAGE_IMMIGRATION
  E7_SPECIFIC_ACTIVITY
  H1_WORKING_HOLIDAY
  OTHER
}

enum CandidateEducationType {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTOR
  BOOTCAMP
  CERTIFICATE
  OTHER
}

enum CandidateEducationStatus {
