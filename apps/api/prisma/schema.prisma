model PartnerOrganization {
  id                               String                        @id @default(uuid())
  partnerType                      PartnerType
  name                             String
  slug                             String                        @unique
  companySize                      PartnerCompanySize?
  officeAddress                    String?
  website                          String?
  socialMedia                      String?
  industry                         PartnerIndustry
  description                      String?
  strengths                        String?
  // 회사 소개 LLM 요약(홈 "이런 회사는 어때요" 카드용). version = 소개+강점 해시로 캐싱.
  descriptionSummary               String?
  descriptionSummaryVersion        String?
  adminMemo                        String?
  businessRegistrationDocumentData String?
  fourInsuranceSubscriberListData  String?
  companyLogoImageData             String?
  officePhotoImageData             String?
  verificationApproved             Boolean                       @default(false)
  verificationApprovedAt           DateTime?
  createdAt                        DateTime                      @default(now())
  updatedAt                        DateTime                      @updatedAt
  positions                        Position[]
  positionRevisions                PositionRevision[]
  users                            User[]
  joinCodes                        PartnerOrganizationJoinCode[]

  @@index([partnerType])
  @@index([companySize])
  @@index([industry])
  @@index([name])
  @@index([slug])
}

model PartnerOrganizationJoinCode {
  id                    String    @id @default(uuid())
  partnerOrganizationId String
  createdByUserId       String
  codeHash              String    @unique
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime  @default(now())

  partnerOrganization PartnerOrganization @relation(fields: [partnerOrganizationId], references: [id], onDelete: Cascade)
  createdByUser       User                @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([partnerOrganizationId])
  @@index([createdByUserId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Position {
  id                      String                      @id @default(uuid())
  partnerOrganizationId   String?
  sourceKind              PositionSourceKind          @default(INTERNAL)
  sourceProvider          PositionSourceProvider      @default(INTERNAL)
  sourceExternalId        String?
  sourceUrl               String?
  sourceFetchedAt         DateTime?
  sourceDeadlineDate      DateTime?
  title                   String
  status                  PositionStatus              @default(DRAFT)
  workType                String?
  employmentType          PositionEmploymentType      @default(UNPAID_INTERN)
  thumbnailImages         String[]                    @default([])
  eligibleVisas           String[]                    @default([])
  preferredNationalities  String[]                    @default([])
  communicationLanguages  String[]                    @default([])
  hiringProcess           String?
  preferredJobRole        String?
  jobAlertSentAt          DateTime? // 비자 매칭 지원자에게 잡 얼럿 발송한 시각(중복 방지)
  hiringCount             Int?
  workingHours            String?
  workLocation            String?
  startDate               DateTime?
  mainResponsibilities    String?
  requiredQualifications  String?
  preferredQualifications String?
  dressCode               String?
  wantsPreTraining        Boolean?
  additionalNotes         String?
  adminMemo               String?
  // 모의 면접(회사 저작) — intent: 면접에서 보려는 포인트, questions: 대표 질문(선택).
  // 지원자는 지원 여부와 무관하게 이걸로 연습+AI 피드백을 받는다.
  mockInterviewIntent     String?
  mockInterviewQuestions  String[]                    @default([])
  viewCount               Int                         @default(0)
  externalClickCount      Int                         @default(0)
  embedding               Unsupported("vector(768)")?
  embeddingUpdatedAt      DateTime?
  // Per-locale translation cache (keyed by BCP47 locale).
  // Shape: { en: { title, mainResponsibilities, requiredQualifications, ... } }
  // Filled lazily on first non-Korean view for INTERNAL postings.
  translations            Json?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  partnerOrganization   PartnerOrganization?          @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  matchingParticipants  PositionMatchingParticipant[]
  progressLogs          PositionProgressLog[]
  statusHistories       PositionStatusHistory[]
  applicantWorkflows    PartnerApplicantWorkflow[]
  applications          Application[]
  revisions             PositionRevision[]
  mockInterviewSessions MockInterviewSession[]

  @@unique([sourceProvider, sourceExternalId])
  @@index([partnerOrganizationId])
  @@index([sourceKind, sourceProvider])
  @@index([status])
  @@index([title])
  @@index([createdAt])
  // /positions "오직 Aply 에서만!" 탭 (sourceProvider=INTERNAL + status=OPEN +
  // ORDER BY createdAt DESC) 가 createdAt 단일 인덱스만 있을 땐 BUDDIES/WANTED 가
  // 위에 가득 쌓여서 INTERNAL 20개 찾을 때까지 heap 을 길게 끌고 갔다. 복합
  // 인덱스로 필터 + 정렬을 한번에 — Postgres 가 ASC 인덱스를 backward 스캔하므로
  // DESC 키워드는 불필요. id 까지 포함해 keyset 페이지네이션의 tiebreaker 도 커버.
  //
  // ⚠️ 이 인덱스는 마이그레이션 파일이 아니라 apps/api/scripts/sync-position-index.sh
  // 가 CREATE INDEX CONCURRENTLY 로 적용한다(락 회피). migrate deploy 로는 안 만들어짐.
  @@index([sourceProvider, status, createdAt, id])
}

model PositionRevision {
  id                    String                 @id @default(uuid())
  positionId            String
  partnerOrganizationId String
  requestedByUserId     String
  status                PositionRevisionStatus @default(PENDING)
  payload               Json
  reviewNote            String?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  position            Position            @relation(fields: [positionId], references: [id], onDelete: Cascade)
  partnerOrganization PartnerOrganization @relation(fields: [partnerOrganizationId], references: [id], onDelete: Cascade)
  requestedByUser     User                @relation("PositionRevisionRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedByUser      User?               @relation("PositionRevisionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([partnerOrganizationId])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@index([status])
  @@index([createdAt])
}

model PositionMatchingParticipant {
  id              String   @id @default(uuid())
  positionId      String
  name            String
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  position  Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("PositionParticipantAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([createdAt])
}

model PositionProgressLog {
  id              String   @id @default(uuid())
  positionId      String
  message         String
  createdByUserId String?
  createdAt       DateTime @default(now())

  position  Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("PositionLogAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([createdAt])
}

model PositionStatusHistory {
  id              String          @id @default(uuid())
  positionId      String
  fromStatus      PositionStatus?
  toStatus        PositionStatus
  note            String?
  createdByUserId String?
  createdAt       DateTime        @default(now())

  position  Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("PositionStatusAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([createdAt])
}

model PartnerApplicantWorkflow {
  id              String   @id @default(uuid())
  partnerUserId   String
  candidateUserId String
  positionId      String
  status          String
  memo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partnerUser   User     @relation("PartnerApplicantWorkflowPartnerUser", fields: [partnerUserId], references: [id], onDelete: Cascade)
  candidateUser User     @relation("PartnerApplicantWorkflowCandidateUser", fields: [candidateUserId], references: [id], onDelete: Cascade)
  position      Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([partnerUserId, candidateUserId, positionId])
  @@index([partnerUserId])
  @@index([candidateUserId])
  @@index([positionId])
}

// 관심 인재 shortlist — 파트너(조직)가 저장해 모아보는 후보. 관계 없이 인덱스 필드로 관리.
model PartnerSavedCandidate {
  id              String   @id @default(uuid())
  organizationId  String
  candidateUserId String
  savedByUserId   String
  note            String?
  createdAt       DateTime @default(now())

  @@unique([organizationId, candidateUserId])
  @@index([organizationId])
}

// 이메일로 팀원을 초대 — 관리자가 이메일을 추가하면 토큰 링크가 발송되고,
// 초대받은 사람이 링크에서 계정을 만들거나 로그인해 이메일을 확인하면 회사에 합류한다.
// User/PartnerOrganization 와 관계 없이 id 컬럼만 보관(가벼운 부가 모델, PartnerSavedCandidate 패턴).
model PartnerOrganizationInvite {
  id                    String              @id @default(uuid())
  partnerOrganizationId String
  email                 String // 소문자 정규화 저장
  partnerOrgRole        PartnerOrgUserRole  @default(MEMBER)
  invitedByUserId       String
  tokenHash             String              @unique
  status                PartnerInviteStatus @default(PENDING)
  expiresAt             DateTime
  acceptedAt            DateTime?
  acceptedByUserId      String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([partnerOrganizationId])
  @@index([email])
  @@index([status])
}

// 파트너가 인재풀(대표 이력서 동의 학생)을 검색해 먼저 연결을 요청하는 흐름.
// 포지션과 무관한 콜드 연결이라 PartnerApplicantWorkflow(포지션 필수)와 별도.
// 학생이 수락(ACCEPTED)해야 파트너가 연락처를 볼 수 있고 메시지를 주고받는다(동의 기반).
model CandidateConnectionRequest {
  id                    String    @id @default(uuid())
  partnerUserId         String
  partnerOrganizationId String? // 요청 시점 파트너 소속(표시·검증용)
  candidateUserId       String
  status                String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  message               String? // 파트너가 남긴 첫 메시지(선택)
  respondedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  partnerUser   User @relation("CandidateConnPartner", fields: [partnerUserId], references: [id], onDelete: Cascade)
  candidateUser User @relation("CandidateConnCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([partnerUserId, candidateUserId])
  @@index([candidateUserId, status])
  @@index([partnerUserId])
}

model Application {
  id                  String            @id @default(uuid())
  positionId          String
  candidateUserId     String
  // 지원 시점에 연결된 대표 이력서(resume-maker) 참조. 조회는 스냅샷 우선.
  resumeId            String?
  // 지원 시점 서류 스냅샷(제출본 보존) — 지원 후 원본을 수정해도 파트너는 제출 당시
  // 그대로 본다. resumeSnapshot=resume.content 사본, coverLetterSnapshot=자소서 사본.
  resumeSnapshot      Json?
  coverLetterId       String?
  coverLetterSnapshot Json?
  status              ApplicationStatus @default(SUBMITTED)
  memo                String?
  submittedAt         DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  position                   Position                   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidateUser              User                       @relation("ApplicationCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)
  resume                     Resume?                    @relation("ApplicationResume", fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter                CoverLetter?               @relation("ApplicationCoverLetter", fields: [coverLetterId], references: [id], onDelete: SetNull)
  statusHistories            ApplicationStatusHistory[]
  interviewSlots             InterviewSlot[]
  assignments                Assignment[]
  program                    Program?
  comments                   ApplicationComment[]
  withdrawnAt                DateTime?
  // 자동 넛지 추적 — 회사가 방치한 지원(SUBMITTED) 리마인더, 지원자가 미선택한 면접 리마인더.
  partnerNudgedAt            DateTime?
  applicantInterviewNudgedAt DateTime?

  @@unique([positionId, candidateUserId])
  @@index([positionId])
  @@index([candidateUserId])
  @@index([status])
  @@index([submittedAt])
  @@index([resumeId])
  @@index([coverLetterId])
}

model InterviewSlot {
  id             String              @id @default(uuid())
  applicationId  String
  startsAt       DateTime
  endsAt         DateTime
  location       String?
  notes          String?
  status         InterviewSlotStatus @default(PROPOSED)
  proposedAt     DateTime            @default(now())
  selectedAt     DateTime?
  cancelledAt    DateTime?
  reminderSentAt DateTime? // 면접 전날 리마인더 발송 시각(중복 방지)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([startsAt])
  @@index([status])
}

model Assignment {
  id                String           @id @default(uuid())
  applicationId     String
  title             String
  description       String
  dueAt             DateTime?
  status            AssignmentStatus @default(ASSIGNED)
  assignedAt        DateTime         @default(now())
  assignedByUserId  String
  submissionContent String?
  submissionLinks   String[]         @default([])
  submittedAt       DateTime?
  feedbackContent   String?
  feedbackRating    Int?
  reviewedAt        DateTime?
  reviewedByUserId  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assignedBy  User        @relation("AssignmentAssignedBy", fields: [assignedByUserId], references: [id])
  reviewedBy  User?       @relation("AssignmentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([status])
  @@index([dueAt])
}

model Program {
  id            String        @id @default(uuid())
  applicationId String        @unique
  startsAt      DateTime      @default(now())
  endsAt        DateTime?
  status        ProgramStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  application         Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  meetings            ProgramMeeting[]
  feedbacks           ProgramFeedback[]
  certificate         Certificate?
  recommendation      Recommendation?
  schoolCreditRequest SchoolCreditRequest?

  @@index([status])
}

model ProgramMeeting {
  id              String               @id @default(uuid())
  programId       String
  scheduledAt     DateTime
  durationMinutes Int                  @default(30)
  agenda          String?
  notes           String?
  location        String?
  status          ProgramMeetingStatus @default(SCHEDULED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([scheduledAt])
  @@index([status])
}

model ProgramFeedback {
  id           String     @id @default(uuid())
  programId    String
  authorUserId String
  authorRole   MemberRole
  content      String
  rating       Int?
  createdAt    DateTime   @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  author  User    @relation("ProgramFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([authorUserId])
}

// Career Launch(부트캠프) 제출물 단위 코치 피드백. 운영자가 학생의 이력서·자소서를
// 보고 남긴 코멘트를 학생 대시보드로 전달한다. Program/Application 파이프라인과
// 무관하게 학생 userId 로 직접 연결한다.
model CareerLaunchFeedback {
  id            String    @id @default(uuid())
  studentUserId String
  authorUserId  String
  week          Int? // 1~4 주차(선택)
  docType       String // "resume" | "cover_letter" | "general"
  docId         String? // 대상 이력서/자소서 id(선택)
  body          String
  readAt        DateTime? // 학생이 확인한 시각
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student User @relation("CareerLaunchFeedbackStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  author  User @relation("CareerLaunchFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
  @@index([authorUserId])
}

// Career Launch 이력서 데이터. 학생이 별도 이력서 빌더로 가지 않고, 프로그램
// 안에서 AI와 대화하며 기본정보·학력·경력·스킬 등을 대화로 쌓는다. 누적된
// 구조화 데이터(content JSON)를 나중에 이력서 형태로 렌더링한다. 학생당 1개.
model CareerResumeData {
  id            String   @id @default(uuid())
  studentUserId String   @unique
  content       Json     @default("{}") // { basic, educations[], experiences[], skills[], languages[] }
  // 이 career-launch 이력서를 미러링한 실제 aply.global Resume(지원·프로필용) id.
  // 저장 시마다 자동 동기화한다. 느슨한 링크(FK 아님) — Resume 삭제 시 재생성.
  resumeId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student User @relation("CareerResumeDataStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
}

// Career Launch 자기소개서 데이터. 이력서와 마찬가지로 별도 빌더 없이 AI와 대화하며
// 자소서 문항·답변을 쌓는다. content JSON = { company, items:[{question, answer}] }. 학생당 1개.
model CareerCoverLetterData {
  id            String   @id @default(uuid())
  studentUserId String   @unique
  content       Json     @default("{}")
  // 이 career-launch 자소서를 미러링한 실제 aply.global CoverLetter(지원·프로필용) id.
  // 저장 시마다 자동 동기화한다. 느슨한 링크(FK 아님) — CoverLetter 삭제 시 재생성.
  coverLetterId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student User @relation("CareerCoverLetterDataStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
}

// Career Launch 진행 상태. 진단결과·선정직무·정리한 직무정보·완료스텝 등 프로그램
// 진행 상태를 계정 기준으로 저장해, 다른 기기·브라우저에서도 그대로 이어가게 한다.
// (기존 localStorage 를 대체) 학생당 1행, state JSON 블롭.
model CareerLaunchProgress {
  id            String    @id @default(uuid())
  studentUserId String    @unique
  state         Json      @default("{}") // { diagnosis, selectedJobs[], materials[], doneSteps[], interview{practiced[],results{}}, finalFeedback }
  opsMemo       String? // 운영자 내부 메모(학생에게 보이지 않음)
  lastNudgedAt  DateTime? // 마지막 독려 메일 발송 시각
  nudgeCount    Int       @default(0) // 누적 독려 메일 발송 횟수
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student User @relation("CareerLaunchProgressStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
}

// 공통 Career Profile(Phase 2) — 진단·직무·이력서·자소서·모의면접이 공유하는 구조화 프로필.
// data: { areas: {areaKey -> Field|Field[]}, rejected: [...] }. 기존 3개 소스에서 최초 1회 병합(mergedAt).
// 원본(CareerResumeData/CareerCoverLetterData/CareerLaunchProgress)은 그대로 유지한다.
model CareerProfile {
  id            String    @id @default(uuid())
  studentUserId String    @unique
  data          Json      @default("{}")
  revision      Int       @default(0) // 낙관적 동시성/병합 버전
  mergedAt      DateTime? // 기존 데이터 최초 병합 시각(1회)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student User @relation("CareerProfileStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
}

// Career Profile 변경 이력(감사 + 거부 해석 추적). 영역·값 단위로만 기록한다.
model CareerProfileEvent {
  id            String   @id @default(uuid())
  studentUserId String
  area          String
  itemKey       String?
  action        String // init_merge | confirm | infer | reject | conflict | update | outdate
  status        String?
  source        String?
  before        Json?
  after         Json?
  createdAt     DateTime @default(now())

  student User @relation("CareerProfileEventStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId, createdAt])
  @@index([studentUserId, area])
}

// Week 1(직무 탐험, Phase 4) — 대표 경험 카드. 학생당 다건. 구조화 STAR + 역량/강점/직무군.
model CareerExperience {
  id                 String    @id @default(uuid())
  studentUserId      String
  cohortId           String?
  title              String
  category           String?
  structuredData     Json      @default("{}") // { situation, task, actions[], result, evidence }
  skills             String[]  @default([])
  strengths          String[]  @default([])
  relatedJobFamilies String[]  @default([])
  source             String?
  confidence         Float?
  userConfirmed      Boolean   @default(false)
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  student User @relation("CareerExperienceStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
}

// Week 1 — 직무 미니체험. (studentUserId, jobKey) 당 1행(재시작=덮어쓰기, 멱등).
model CareerJobTrial {
  id             String    @id @default(uuid())
  studentUserId  String
  cohortId       String?
  jobKey         String
  templateId     String
  status         String    @default("in_progress") // in_progress | submitted | evaluated
  difficulty     String    @default("medium")
  promptData     Json      @default("{}")
  submissionData Json?
  evaluationData Json?
  score          Int?
  interestScore  Int?
  interestData   Json?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student User @relation("CareerJobTrialStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, jobKey])
  @@index([studentUserId])
}

// Week 1 — 목표/도전/대안 직무. (studentUserId, jobKey) 당 1행.
model CareerTargetJob {
  id            String    @id @default(uuid())
  studentUserId String
  cohortId      String?
  jobKey        String
  targetType    String    @default("primary") // primary | challenge | alternative
  status        String    @default("provisional") // provisional | exploring | confirmed | rejected
  reason        String?
  readinessData Json?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student User @relation("CareerTargetJobStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, jobKey])
  @@index([studentUserId])
}

// Week 1 — 직무 결정 리포트(학생당 1, 재생성 upsert).
model CareerJobDecisionReport {
  id             String   @id @default(uuid())
  studentUserId  String   @unique
  cohortId       String?
  comparedJobs   Json     @default("[]")
  recommendation Json     @default("{}")
  evidence       Json     @default("[]")
  concerns       Json     @default("[]")
  nextActions    Json     @default("[]")
  userDecision   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student User @relation("CareerJobDecisionReportStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
}

// Week 2(지원 패키지, Phase 5) — 기준 채용공고. 원문(rawContent)과 AI 구조화/분석을 분리 저장.
model CareerApplicationTarget {
  id             String    @id @default(uuid())
  studentUserId  String
  cohortId       String?
  positionId     String? // APLY 내부 공고면 느슨 참조(FK 아님)
  sourceType     String    @default("paste") // internal | saved | url | paste | manual
  sourceUrl      String?
  companyName    String?
  jobTitle       String?
  rawContent     String? // 원문
  structuredData Json      @default("{}") // JdStructured
  analysisData   Json? // JdAnalysis
  status         String    @default("captured") // captured | structured | analyzed
  capturedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student User @relation("CareerApplicationTargetStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
}

// Week 2 — 문서 버전(대표/공고맞춤). 대표 이력서를 덮어쓰지 않고 별도 버전으로 관리.
model CareerDocumentVersion {
  id                  String    @id @default(uuid())
  studentUserId       String
  cohortId            String?
  documentType        String // resume | cover
  variant             String    @default("master") // master | targeted
  applicationTargetId String? // targeted 면 어느 공고 기준
  version             Int       @default(1)
  content             Json      @default("{}") // ResumeVersionContent | CoverVersionContent
  sourceLinks         Json      @default("[]") // SourceLink[] — 문장별 근거/검증
  validationData      Json? // 검증 집계
  generatedBy         String? // ai | user | hybrid
  promptVersion       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student User @relation("CareerDocumentVersionStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId, documentType])
  @@index([studentUserId, applicationTargetId])
}

// Week 2 — 지원 패키지(공고당 1). 이력서·자소서 버전 + 점수 + 검증 + 최종 확정.
model CareerApplicationPackage {
  id                  String    @id @default(uuid())
  studentUserId       String
  cohortId            String?
  targetJobKey        String? // Week1 목표 직무군
  applicationTargetId String
  resumeVersionId     String?
  coverVersionId      String?
  status              String    @default("draft") // draft | checking | finalized
  readinessScore      Int?
  scoreData           Json? // { resume, cover, jdMatch, readiness }
  validationData      Json? // consistency findings 요약
  finalizedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student User @relation("CareerApplicationPackageStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, applicationTargetId])
  @@index([studentUserId])
}

// Week 2 → Week 3 인계 — 예상 면접 질문 세트(생성·저장까지만, 진행은 Phase 6).
model CareerInterviewQuestionSet {
  id                   String   @id @default(uuid())
  studentUserId        String
  cohortId             String?
  applicationPackageId String?
  questions            Json     @default("[]") // InterviewQuestion[]
  promptVersion        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  student User @relation("CareerInterviewQuestionSetStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
}

// Week 3~4(실전 모의면접, Phase 6) — 면접 세션.
model CareerInterviewSession {
  id                   String    @id @default(uuid())
  studentUserId        String
  cohortId             String?
  applicationPackageId String?
  sessionType          String    @default("initial_mock") // initial_mock | practice | retry | final_mock
  status               String    @default("ready") // ready | in_progress | paused | completed | abandoned | failed
  inputMode            String    @default("text") // text | voice_to_text
  questionSetVersion   String?
  scoringVersion       String?
  promptVersion        String?
  reportData           Json? // 세션 종합 평가/리포트 캐시
  cursor               Int       @default(0) // 진행 커서(다음 질문)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  student User @relation("CareerInterviewSessionStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId, sessionType])
}

// Week 3~4 — 세션 질문(꼬리질문은 parentQuestionId).
model CareerInterviewQuestion {
  id                 String   @id @default(uuid())
  studentUserId      String
  sessionId          String
  sourceQuestionId   String? // Phase5 예상질문 등 원본
  question           String
  type               String
  sourceData         Json? // 생성 근거
  evaluationCriteria Json      @default("[]")
  difficulty         String    @default("medium")
  order              Int       @default(0)
  parentQuestionId   String? // 꼬리질문이면 부모
  createdAt          DateTime  @default(now())

  student User @relation("CareerInterviewQuestionStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId, sessionId])
}

// Week 3~4 — 질문별 답변 + 평가.
model CareerInterviewAnswer {
  id             String    @id @default(uuid())
  studentUserId  String
  sessionId      String
  questionId     String
  answerText     String    @default("")
  audioAssetId   String? // 음성 인프라 있을 때만(현재 미사용)
  duration       Int? // 답변 시간(초)
  evaluationData Json? // AnswerEvaluation
  score          Int?
  confidence     Float?
  answeredAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student User @relation("CareerInterviewAnswerStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([studentUserId, sessionId])
}

// Week 3 — 반복 취약 패턴.
model CareerInterviewWeakness {
  id                   String   @id @default(uuid())
  studentUserId        String
  cohortId             String?
  applicationPackageId String?
  weaknessType         String
  title                String
  evidence             Json     @default("[]")
  severity             String    @default("medium")
  occurrenceCount      Int       @default(1)
  priority             Int       @default(5)
  coachingStrategy     String?
  status               String    @default("open") // open | resolved
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  student User @relation("CareerInterviewWeaknessStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
}

// Week 4 — 오답노트(취약점 기반 재훈련 단위).
model CareerInterviewCorrection {
  id                  String    @id @default(uuid())
  studentUserId       String
  cohortId            String?
  weaknessId          String?
  originalQuestionId  String?
  originalAnswerId    String?
  question            String    @default("")
  questionType        String?
  status              String    @default("discovered") // discovered|coaching|retrying|transfer_test|passed|paused|archived
  coachingData        Json?
  passCriteria        Json?
  attemptCount        Int       @default(0)
  transferAttemptCount Int      @default(0)
  initialScore        Int?
  latestScore         Int?
  passedAt            DateTime?
  passReason          Json?
  lastPracticedAt     DateTime?
  nextPracticeAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student User @relation("CareerInterviewCorrectionStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
}

// Week 4 — 오답 재도전 시도(같은질문/유사질문/꼬리질문).
model CareerInterviewCorrectionAttempt {
  id             String   @id @default(uuid())
  studentUserId  String
  correctionId   String
  sessionId      String?
  questionText   String   @default("")
  answerText     String   @default("")
  attemptType    String   @default("same_question") // same_question | similar_question | follow_up
  evaluationData Json?
  score          Int?
  passed         Boolean  @default(false)
  createdAt      DateTime @default(now())

  student User @relation("CareerInterviewCorrectionAttemptStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId, correctionId])
}

// Week 4 — 최초·최종 비교 + 성장 리포트(학생당 1, 재생성 upsert).
model CareerInterviewGrowthReport {
  id                   String   @id @default(uuid())
  studentUserId        String   @unique
  cohortId             String?
  applicationPackageId String?
  initialSessionId     String?
  finalSessionId       String?
  comparisonData       Json?
  growthData           Json?
  remainingWeaknesses  Json     @default("[]")
  nextActions          Json     @default("{}")
  humanReviewRequired  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  student User @relation("CareerInterviewGrowthReportStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
}

// Phase 7 — 경쟁·리그·동기부여·운영자 개입.
model CareerLeague {
  id             String   @id @default(uuid())
  cohortId       String
  type           String // cohort | job_family | weekly_growth | correction | consistency
  jobFamilyKey   String?
  name           String
  status         String   @default("active")
  minMembers     Int      @default(10)
  maxMembers     Int      @default(20)
  scoringVersion String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([cohortId, type])
}

model CareerLeagueMember {
  id            String    @id @default(uuid())
  leagueId      String
  enrollmentId  String
  studentUserId String
  joinedAt      DateTime  @default(now())
  leftAt        DateTime?
  status        String    @default("active")

  @@unique([leagueId, enrollmentId])
  @@index([studentUserId])
}

model CareerLeagueScore {
  id                String   @id @default(uuid())
  studentUserId     String
  cohortId          String?
  leagueId          String?
  scoringVersion    String
  missionScore      Int      @default(0)
  artifactScore     Int      @default(0)
  growthScore       Int      @default(0)
  practiceScore     Int      @default(0)
  correctionScore   Int      @default(0)
  contributionScore Int      @default(0)
  totalScore        Int      @default(0)
  rank              Int?
  percentile        Int?
  previousRank      Int?
  rankDelta         Int?
  sourceSnapshot    Json?
  calculatedAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student User @relation("CareerLeagueScoreStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, leagueId])
  @@index([leagueId])
}

model CareerLeagueSnapshot {
  id             String   @id @default(uuid())
  leagueId       String
  scoringVersion String?
  snapshotAt     DateTime @default(now())
  rankingData    Json     @default("[]")
  aggregateData  Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([leagueId, snapshotAt])
}

model CareerAchievement {
  id              String   @id @default(uuid())
  studentUserId   String
  enrollmentId    String?
  badgeKey        String
  criteriaVersion String?
  sourceData      Json?
  earnedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  student User @relation("CareerAchievementStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, badgeKey])
  @@index([studentUserId])
}

model CareerCohortGoal {
  id            String    @id @default(uuid())
  cohortId      String
  goalType      String
  targetValue   Int
  currentValue  Int       @default(0)
  startAt       DateTime?
  endAt         DateTime?
  status        String    @default("active")
  configuration Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([cohortId])
}

model CareerIntervention {
  id             String    @id @default(uuid())
  studentUserId  String
  enrollmentId   String?
  cohortId       String?
  priority       String    @default("medium") // critical|high|medium|low|resolved
  status         String    @default("open") // open|assigned|contacted|in_review|waiting_user|resolved|dismissed
  reasonCodes    String[]  @default([])
  evidence       Json?
  aiSummary      Json?
  assignedAdminId String?
  nextReviewAt   DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student User @relation("CareerInterventionStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([cohortId, priority])
  @@index([studentUserId])
}

model CareerInterventionLog {
  id             String   @id @default(uuid())
  interventionId String
  actorId        String?
  action         String
  previousStatus String?
  nextStatus     String?
  note           String?
  createdAt      DateTime @default(now())

  @@index([interventionId])
}

// ── Phase 9 파일럿 측정 모델(모두 additive) ──

// 파일럿 주차별 짧은 인앱 설문 응답 — surveyKey 별 1건(중복 노출 방지). 5점 척도 응답 + 선택 주관식.
model CareerPilotSurvey {
  id            String   @id @default(uuid())
  studentUserId String
  cohortId      String?
  surveyKey     String // consult_end | week1_end | week2_end | week3_end | week4_end | competition
  answers       Json // { questionKey: 1..5 }
  comment       String? // 선택 주관식(최대 500자)
  createdAt     DateTime @default(now())

  student User @relation("CareerPilotSurveyStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, surveyKey])
  @@index([cohortId, surveyKey])
}

// 정성 피드백 신호 — 원문 없이 category·severity 만 저장한다(개인정보/원문 미포함).
model CareerQualitativeFeedback {
  id            String    @id @default(uuid())
  studentUserId String
  cohortId      String?
  category      String // already_answered | want_human | content_lost | ...
  severity      String    @default("medium") // critical | high | medium | low
  currentWeek   Int?
  currentStep   String?
  sessionId     String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  student User @relation("CareerQualitativeFeedbackStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([cohortId, category])
  @@index([studentUserId])
}

// LLM 비용 일별 집계 — cohort × feature × 날짜(KST YYYY-MM-DD) × model × promptVersion 로 합산.
// 원문 미저장. 토큰·재시도·캐시·실패·추정비용만. promptVersion 으로 프롬프트 개선 전후 오류/비용 비교.
model CareerAiCostDaily {
  id            String   @id @default(uuid())
  cohortId      String? // null=기수 미상(등록 매핑 실패)
  feature       String // consult | resume | interview_eval | ...
  dateKey       String // KST "YYYY-MM-DD"
  model         String   @default("")
  promptVersion String   @default("") // 프롬프트 버전(없으면 "")
  calls         Int      @default(0)
  inputTokens   BigInt   @default(0)
  outputTokens  BigInt   @default(0)
  retries       Int      @default(0)
  cacheHits     Int      @default(0)
  failures      Int      @default(0)
  estCostUsd    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([cohortId, feature, dateKey, model, promptVersion])
  @@index([cohortId, dateKey])
}

// Phase 10 행동 이벤트(append-only) — 다음 파일럿 분석용. 원문/개인정보 없음(정해진 kind + week/step/sessionId).
model CareerActivityEvent {
  id            String   @id @default(uuid())
  studentUserId String
  cohortId      String?
  kind          String // week_enter | next_action_click | league_view | suggestion_accept | skip | ...
  week          Int?
  step          String?
  sessionId     String?
  createdAt     DateTime @default(now())

  student User @relation("CareerActivityEventStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([cohortId, kind])
  @@index([studentUserId, createdAt])
}

// Career Launch 기수(Cohort) — 대학·기수 단위로 운영한다. 등록(CareerEnrollment)된
// 학생만 프로그램에 접근할 수 있고, 운영자가 어드민에서 기수·등록을 관리한다.
model CareerCohort {
  id         String    @id @default(uuid())
  university String // 대학명 (예: 고려대학교) — 레거시 테넌트 키. Organization 도입 후에도 호환 위해 유지.
  name       String // 기수 이름 (예: 2기)
  inviteCode String    @unique // 초대코드 자가등록용
  startsAt   DateTime?
  endsAt     DateTime?
  status     String    @default("active") // active | ended
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // ── Phase 11 B2B(additive) — 기관 연결. nullable → 기존 기수 무영향, backfill 로 채운다. ──
  organizationId String?
  templateId     String? // 생성 시 사용한 프로그램 템플릿(스냅샷은 CareerCohortTemplateSnapshot)

  // ── Phase 9 파일럿 운영 config(additive) ──
  isPilot                 Boolean   @default(false) // 파일럿 기수 식별
  programVersion          String? // 예: "v2"
  featureFlags            Json? // { career_launch_v2: true, ... }
  participantLimit        Int? // 파일럿 정원(10~20)
  pilotStartAt            DateTime?
  pilotEndAt              DateTime?
  surveyConfiguration     Json? // { enabledSurveys: [...], ... }
  monitoringConfiguration Json? // { kpiTargets: {...}, manualChecks: {...}, supportContact, stopFlags: {...} }

  enrollments        CareerEnrollment[]
  employmentOutcomes CareerEmploymentOutcome[]
  satisfactions      CareerLaunchSatisfaction[]
  certificates       CareerLaunchCertificate[]
  seminars           CareerSeminar[]
  weeks              CareerCohortWeek[]

  @@index([status])
  @@index([organizationId])
}

// ══ Phase 11 대학·기관 B2B 운영 확장(모두 additive) ══════════════════════

// 기관(대학 외 기관 포함). 채용사 PartnerOrganization 과 별개(교육/운영 테넌트).
model Organization {
  id            String   @id @default(uuid())
  name          String
  type          String // university | college | vocational_school | public_agency | employment_center | nonprofit | corporate_program | other
  status        String   @default("prospect") // prospect|onboarding|active|suspended|expired|archived
  slug          String?  @unique
  primaryContact String?
  contactEmail  String?
  timezone      String?  @default("Asia/Seoul")
  locale        String?  @default("ko")
  configuration Json? // { branding, privacy, reportConfig, dataRetentionPolicy, settings }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships OrganizationMembership[]
  licenses    OrganizationLicense[]
  reports     CareerOrganizationReport[]
  auditLogs   OrganizationAuditLog[]

  @@index([status])
  @@index([type])
}

// 기관 소속 사용자 + 기관 범위 역할. 서버가 이 membership 으로 org-scope 를 강제한다.
model OrganizationMembership {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String // org_admin | org_observer | instructor | counselor
  status         String   @default("active") // active | inactive
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrgMembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, role])
  @@index([userId])
  @@index([organizationId, role])
}

// 프로그램 템플릿 — 4주 구성·규칙·설문·flag·KPI 등을 configuration 에 담는다. 버전 관리.
model CareerProgramTemplate {
  id             String   @id @default(uuid())
  name           String
  version        Int      @default(1)
  programVersion String? // 예: "v2"
  status         String   @default("active") // active | archived
  configuration  Json // { durationWeeks, weeks, missions, completion, seminars, surveys, flags, jobTrials, packageRules, interviewRules, competition, interventionRules, notifications, kpiTargets, reportConfig }
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  snapshots CareerCohortTemplateSnapshot[]

  @@index([status])
}

// 기수 생성 시 템플릿 스냅샷 — 이후 템플릿을 수정해도 진행 중 기수는 이 스냅샷을 따른다.
model CareerCohortTemplateSnapshot {
  id              String   @id @default(uuid())
  cohortId        String   @unique
  templateId      String?
  templateVersion Int?
  configuration   Json
  createdAt       DateTime @default(now())

  template CareerProgramTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([templateId])
}

// 기관 라이선스/좌석. 결제는 없지만 추후 연결 가능한 사용량 데이터.
model OrganizationLicense {
  id              String    @id @default(uuid())
  organizationId  String
  contractedSeats Int?
  startAt         DateTime?
  endAt           DateTime?
  status          String    @default("draft") // draft|active|exhausted|expired|suspended
  overagePolicy   String?   @default("block") // block | allow
  configuration   Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// 강사·상담자 배정(기관/기수/주차/학생/개입 범위).
model CareerStaffAssignment {
  id             String    @id @default(uuid())
  organizationId String?
  cohortId       String?
  userId         String
  role           String // instructor | counselor
  scopeType      String // organization | cohort | week | student | intervention
  scopeId        String? // scopeType 에 따른 대상 id(week 는 "1".."4")
  status         String    @default("active") // active | inactive
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation("CareerStaffAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([cohortId])
  @@index([userId])
}

// 기관 제출용 성과 리포트 스냅샷(집계만, 원문 없음). 생성 시점 지표 고정 + metricVersion.
model CareerOrganizationReport {
  id             String   @id @default(uuid())
  organizationId String
  cohortId       String? // null=기관 전체
  reportType     String // organization_summary | cohort_performance
  metricVersion  String
  snapshotData   Json
  generatedBy    String?
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, cohortId])
}

// 기관 감사 로그 — 민감 원문(비밀번호·토큰·이력서/상담 원문) 미저장. before/after 는 요약 변경분만.
model OrganizationAuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorId        String?
  actorRole      String?
  action         String
  targetType     String?
  targetId       String?
  changeData     Json? // { before, after } — 민감 원문 제외
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
}

// Career Launch 기수별 주차 오픈 일정 — 운영자가 각 주차(1~4)의 오픈일을 지정하거나
// 강제 오픈할 수 있다. 학생 주차 게이팅이 이 값을 참조한다.
model CareerCohortWeek {
  id        String    @id @default(uuid())
  cohortId  String
  week      Int // 1~4 주차
  opensAt   DateTime? // 이 시각 이후 자동 오픈(null이면 미지정)
  forceOpen Boolean   @default(false) // 운영자 강제 오픈(날짜 무관 즉시 열림)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  cohort CareerCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, week])
  @@index([cohortId])
}

// Career Launch 세미나 일정 — 기수별·주차별 1건. 운영자가 입력하고 학생 주차 화면에 노출된다.
model CareerSeminar {
  id        String   @id @default(uuid())
  cohortId  String
  week      Int // 1~4 주차
  title     String?
  startsAt  DateTime
  location  String? // 오프라인 장소 또는 안내 문구
  online    Boolean  @default(false)
  url       String? // 온라인 접속 링크(Zoom 등)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohort CareerCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, week])
  @@index([cohortId])
}

// Career Launch 등록 — 학생을 기수에 연결한다. 등록이 있어야 프로그램에 접근 가능.
model CareerEnrollment {
  id            String   @id @default(uuid())
  cohortId      String
  studentUserId String
  createdAt     DateTime @default(now())

  cohort  CareerCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  student User         @relation("CareerEnrollmentStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([cohortId, studentUserId])
  @@index([studentUserId])
}

// Career Launch 취업 성과 — 수료생의 실제 취업 결과를 기록한다.
// aply.global 내부(INTERNAL) 공고뿐 아니라 외부 공고·오프라인 채용까지 모든 경로를 포괄한다
// (외부 공고 지원은 익명 클릭이라 학생별 귀속이 안 되므로, 운영자가 결과를 직접 기록한다).
model CareerEmploymentOutcome {
  id              String                  @id @default(uuid())
  studentUserId   String
  cohortId        String?
  status          EmploymentOutcomeStatus @default(APPLIED)
  companyName     String
  positionTitle   String?
  source          String? // "INTERNAL" | "WANTED" | "BUDDIES" | "EXTERNAL" | "OFFLINE"
  positionId      String? // aply.global 포지션이면 연결(선택)
  note            String?
  decidedAt       DateTime? // 합격/최종 확정 시각
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  student User          @relation("CareerEmploymentOutcomeStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  cohort  CareerCohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@index([studentUserId])
  @@index([cohortId])
  @@index([status])
}

// Career Launch 만족도/추천(NPS) — 수료생이 남기는 프로그램 평가. 학교 리포트의 정성 지표.
model CareerLaunchSatisfaction {
  id            String   @id @default(uuid())
  studentUserId String
  cohortId      String
  rating        Int // 1~5 만족도
  npsScore      Int? // 0~10 추천 점수(NPS)
  comment       String? // 후기/추천사
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student User         @relation("CareerLaunchSatisfactionStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  cohort  CareerCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, studentUserId])
  @@index([cohortId])
}

// Career Launch 수료증 — 기수 단위 프로그램 수료 인증(내부 Program 수료증과 별개).
model CareerLaunchCertificate {
  id             String   @id @default(uuid())
  studentUserId  String
  cohortId       String
  certificateNo  String   @unique
  issuedByUserId String?
  issuedAt       DateTime @default(now())

  student  User         @relation("CareerLaunchCertificateStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  cohort   CareerCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  issuedBy User?        @relation("CareerLaunchCertificateIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@unique([cohortId, studentUserId])
  @@index([cohortId])
}

enum EmploymentOutcomeStatus {
  APPLIED // 지원
  INTERVIEW // 면접
  OFFER // 합격(오퍼)
  HIRED // 최종 입사
  REJECTED // 불합격
}

model Certificate {
  id             String   @id @default(uuid())
  programId      String   @unique
  title          String
  content        String
  issuedByUserId String
  issuedAt       DateTime @default(now())

  program  Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  issuedBy User    @relation("CertificateIssuer", fields: [issuedByUserId], references: [id])

  @@index([programId])
}

model Recommendation {
  id             String   @id @default(uuid())
  programId      String   @unique
  content        String
  signerName     String
  signerTitle    String?
  issuedByUserId String
  issuedAt       DateTime @default(now())

  program  Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  issuedBy User    @relation("RecommendationIssuer", fields: [issuedByUserId], references: [id])

  @@index([programId])
}

model SchoolCreditRequest {
  id               String             @id @default(uuid())
  programId        String             @unique
  schoolName       String
  courseCode       String?
  credits          Int                @default(0)
  status           SchoolCreditStatus @default(REQUESTED)
  requestedAt      DateTime           @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewNote       String?

  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("SchoolCreditReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([status])
}

model ApplicationStatusHistory {
  id              String            @id @default(uuid())
  applicationId   String
  status          ApplicationStatus
  changedByUserId String?
  memo            String?
  changedAt       DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
