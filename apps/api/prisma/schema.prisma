model PartnerOrganization {
  id                               String          @id @default(uuid())
  partnerType                      PartnerType
  name                             String
  slug                             String          @unique
  companySize                      PartnerCompanySize?
  officeAddress                    String?
  website                          String?
  socialMedia                      String?
  industry                         PartnerIndustry
  description                      String?
  strengths                        String?
  adminMemo                        String?
  businessRegistrationDocumentData String?
  fourInsuranceSubscriberListData  String?
  companyLogoImageData             String?
  officePhotoImageData             String?
  verificationApproved             Boolean         @default(false)
  verificationApprovedAt           DateTime?
  createdAt                        DateTime        @default(now())
  updatedAt                        DateTime        @updatedAt
  positions                        Position[]
  positionRevisions                PositionRevision[]
  users                            User[]
  joinCodes                        PartnerOrganizationJoinCode[]

  @@index([partnerType])
  @@index([companySize])
  @@index([industry])
  @@index([name])
  @@index([slug])
}

model PartnerOrganizationJoinCode {
  id                    String   @id @default(uuid())
  partnerOrganizationId String
  createdByUserId       String
  codeHash              String   @unique
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime @default(now())

  partnerOrganization PartnerOrganization @relation(fields: [partnerOrganizationId], references: [id], onDelete: Cascade)
  createdByUser       User                @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([partnerOrganizationId])
  @@index([createdByUserId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Position {
  id                      String         @id @default(uuid())
  partnerOrganizationId   String?
  sourceKind              PositionSourceKind @default(INTERNAL)
  sourceProvider          PositionSourceProvider @default(INTERNAL)
  sourceExternalId        String?
  sourceUrl               String?
  sourceFetchedAt         DateTime?
  sourceDeadlineDate      DateTime?
  title                   String
  status                  PositionStatus @default(DRAFT)
  workType                String?
  employmentType          PositionEmploymentType @default(UNPAID_INTERN)
  thumbnailImages         String[]       @default([])
  eligibleVisas           String[]       @default([])
  preferredNationalities  String[]       @default([])
  communicationLanguages  String[]       @default([])
  hiringProcess           String?
  preferredJobRole        String?
  hiringCount             Int?
  workingHours            String?
  workLocation            String?
  startDate               DateTime?
  mainResponsibilities    String?
  requiredQualifications  String?
  preferredQualifications String?
  dressCode               String?
  wantsPreTraining        Boolean?
  additionalNotes         String?
  adminMemo               String?
  viewCount               Int            @default(0)
  externalClickCount      Int            @default(0)
  embedding               Unsupported("vector(768)")?
  embeddingUpdatedAt      DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  partnerOrganization PartnerOrganization? @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  matchingParticipants PositionMatchingParticipant[]
  progressLogs PositionProgressLog[]
  statusHistories PositionStatusHistory[]
  applicantWorkflows PartnerApplicantWorkflow[]
  applications Application[]
  revisions PositionRevision[]

  @@index([partnerOrganizationId])
  @@index([sourceKind, sourceProvider])
  @@unique([sourceProvider, sourceExternalId])
  @@index([status])
  @@index([title])
  @@index([createdAt])
}

model PositionRevision {
  id                    String                 @id @default(uuid())
  positionId            String
  partnerOrganizationId String
  requestedByUserId     String
  status                PositionRevisionStatus @default(PENDING)
  payload               Json
  reviewNote            String?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  position            Position            @relation(fields: [positionId], references: [id], onDelete: Cascade)
  partnerOrganization PartnerOrganization @relation(fields: [partnerOrganizationId], references: [id], onDelete: Cascade)
  requestedByUser     User                @relation("PositionRevisionRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedByUser      User?               @relation("PositionRevisionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([partnerOrganizationId])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@index([status])
  @@index([createdAt])
}

model PositionMatchingParticipant {
  id              String   @id @default(uuid())
  positionId      String
  name            String
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("PositionParticipantAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([createdAt])
}

model PositionProgressLog {
  id              String   @id @default(uuid())
  positionId      String
  message         String
  createdByUserId String?
  createdAt       DateTime @default(now())

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("PositionLogAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([createdAt])
}

model PositionStatusHistory {
  id              String         @id @default(uuid())
  positionId      String
  fromStatus      PositionStatus?
  toStatus        PositionStatus
  note            String?
  createdByUserId String?
  createdAt       DateTime       @default(now())

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("PositionStatusAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([createdAt])
}

model PartnerApplicantWorkflow {
  id              String   @id @default(uuid())
  partnerUserId   String
  candidateUserId String
  positionId      String
  status          String
  memo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partnerUser User     @relation("PartnerApplicantWorkflowPartnerUser", fields: [partnerUserId], references: [id], onDelete: Cascade)
  candidateUser User   @relation("PartnerApplicantWorkflowCandidateUser", fields: [candidateUserId], references: [id], onDelete: Cascade)
  position      Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([partnerUserId, candidateUserId, positionId])
  @@index([partnerUserId])
  @@index([candidateUserId])
  @@index([positionId])
}

model Application {
  id              String            @id @default(uuid())
  positionId      String
  candidateUserId String
  status          ApplicationStatus @default(SUBMITTED)
  memo            String?
  submittedAt     DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  position        Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidateUser   User     @relation("ApplicationCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)
  statusHistories ApplicationStatusHistory[]
  interviewSlots  InterviewSlot[]
  assignments     Assignment[]
  program         Program?
  comments        ApplicationComment[]
  withdrawnAt     DateTime?

  @@unique([positionId, candidateUserId])
  @@index([positionId])
  @@index([candidateUserId])
  @@index([status])
  @@index([submittedAt])
}

model InterviewSlot {
  id            String              @id @default(uuid())
  applicationId String
  startsAt      DateTime
  endsAt        DateTime
  location      String?
  notes         String?
  status        InterviewSlotStatus @default(PROPOSED)
  proposedAt    DateTime            @default(now())
  selectedAt    DateTime?
  cancelledAt   DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([startsAt])
  @@index([status])
}

model Assignment {
  id                String           @id @default(uuid())
  applicationId     String
  title             String
  description       String
  dueAt             DateTime?
  status            AssignmentStatus @default(ASSIGNED)
  assignedAt        DateTime         @default(now())
  assignedByUserId  String
  submissionContent String?
  submissionLinks   String[]         @default([])
  submittedAt       DateTime?
  feedbackContent   String?
  feedbackRating    Int?
  reviewedAt        DateTime?
  reviewedByUserId  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assignedBy  User        @relation("AssignmentAssignedBy", fields: [assignedByUserId], references: [id])
  reviewedBy  User?       @relation("AssignmentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([status])
  @@index([dueAt])
}

model Program {
  id            String        @id @default(uuid())
  applicationId String        @unique
  startsAt      DateTime      @default(now())
  endsAt        DateTime?
  status        ProgramStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  application         Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  meetings            ProgramMeeting[]
  feedbacks           ProgramFeedback[]
  certificate         Certificate?
  recommendation      Recommendation?
  schoolCreditRequest SchoolCreditRequest?

  @@index([status])
}

model ProgramMeeting {
  id              String               @id @default(uuid())
  programId       String
  scheduledAt     DateTime
  durationMinutes Int                  @default(30)
  agenda          String?
  notes           String?
  location        String?
  status          ProgramMeetingStatus @default(SCHEDULED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([scheduledAt])
  @@index([status])
}

model ProgramFeedback {
  id           String     @id @default(uuid())
  programId    String
  authorUserId String
  authorRole   MemberRole
  content      String
  rating       Int?
  createdAt    DateTime   @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  author  User    @relation("ProgramFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([authorUserId])
}

model Certificate {
  id             String   @id @default(uuid())
  programId      String   @unique
  title          String
  content        String
  issuedByUserId String
  issuedAt       DateTime @default(now())

  program  Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  issuedBy User    @relation("CertificateIssuer", fields: [issuedByUserId], references: [id])

  @@index([programId])
}

model Recommendation {
  id             String   @id @default(uuid())
  programId      String   @unique
  content        String
  signerName     String
  signerTitle    String?
  issuedByUserId String
  issuedAt       DateTime @default(now())

  program  Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  issuedBy User    @relation("RecommendationIssuer", fields: [issuedByUserId], references: [id])

  @@index([programId])
}

model SchoolCreditRequest {
  id               String             @id @default(uuid())
  programId        String             @unique
  schoolName       String
  courseCode       String?
  credits          Int                @default(0)
  status           SchoolCreditStatus @default(REQUESTED)
  requestedAt      DateTime           @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewNote       String?

  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("SchoolCreditReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([status])
}

model ApplicationStatusHistory {
  id              String            @id @default(uuid())
  applicationId   String
  status          ApplicationStatus
  changedByUserId String?
  memo            String?
  changedAt       DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("ApplicationStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([changedByUserId])
}

model IssueReport {
  id              String            @id @default(uuid())
  type            IssueReportType
  status          IssueReportStatus @default(OPEN)
  title           String
  description     String
  reporterUserId  String
  subjectUserId   String?
  positionId      String?
  applicationId   String?
  assignedToUserId String?
  resolutionNote  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  resolvedAt      DateTime?

  reporter   User @relation("IssueReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  subject    User? @relation("IssueReportSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("IssueReportAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([reporterUserId])
  @@index([assignedToUserId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String?
  linkPath  String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model ApplicationComment {
  id             String                       @id @default(uuid())
  applicationId  String
  authorUserId   String
  authorRole     MemberRole
  content        String
  visibility     ApplicationCommentVisibility @default(INTERNAL)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation("ApplicationCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([authorUserId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorRole   MemberRole?
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
}

model Announcement {
  id          String               @id @default(uuid())
  title       String
  body        String
  severity    AnnouncementSeverity @default(INFO)
  audience    AnnouncementAudience @default(ALL)
  linkPath    String?
  active      Boolean              @default(true)
  startsAt    DateTime             @default(now())
  endsAt      DateTime?
  createdByUserId String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([active, audience])
  @@index([startsAt])
}

model AppSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model MatchingRunHistory {
  id             String   @id @default(uuid())
  mode           String
  source         String?
  positionId     String?
  candidateId    String?
  positionTitle  String?
  candidateLabel String?
  resultCount    Int      @default(0)
  results        Json
  ranAt          DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([mode])
  @@index([positionId])
  @@index([candidateId])
}

model CandidateProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  workPermit        Boolean?
  visaType          CandidateVisaType?
  visaExpiryDate    DateTime?
  livesInKorea      Boolean?
  hasAccommodation  Boolean?
  residenceProvince String?
  residenceDistrict String?
  residenceAddress  String?
  preferredProgramDuration CandidateProgramDuration?
  programStartOption CandidateProgramStartOption?
  programStartDate  DateTime?
  preferredIndustries PartnerIndustry[] @default([])
  preferredJobRoles CandidatePreferredJobRole[] @default([])
  favoritePositionIds String[] @default([])
  appliedPositionIds String[] @default([])
  skills            String[] @default([])
  selfIntroduction  String?
  programMotivation String?
  preferenceConditionNote String?
  capabilityNote    String?
  additionalInfoNote String?
  emergencyContactName String?
  emergencyContactRelation String?
  emergencyContactPhone String?
  emergencyContactEmail String?
  emergencyContactAddress String?
  matchingResultNote String?
  resumeUrl         String?
  resumeFileName    String?
  coverLetterUrl    String?
  coverLetterFileName String?
  portfolioUrl      String?
  portfolioFileName String?
  passportImageUrl  String?
  passportImageFileName String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations CandidateEducation[]
  languageSkills CandidateLanguageSkill[]
  careers CandidateCareer[]
  activityExperiences CandidateActivityExperience[]

  @@index([visaType])
  @@index([livesInKorea])
}

model CandidateCareer {
  id                 String   @id @default(uuid())
  candidateProfileId String
  companyName        String
  position           String
  department         String?
  isCurrent          Boolean  @default(false)
  startDate          DateTime?
  endDate            DateTime?
  description        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@index([isCurrent])
}

model CandidateEducation {
  id            String                  @id @default(uuid())
  candidateProfileId String
  schoolName    String
  educationType CandidateEducationType
  major         String?
  status        CandidateEducationStatus
  country       String?
  city          String?
  startDate     DateTime?
  endDate       DateTime?
  isKoreanSchool Boolean?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@index([educationType])
  @@index([status])
}

model CandidateLanguageSkill {
  id            String                @id @default(uuid())
  candidateProfileId String
  language      CandidateLanguageType
  level         CandidateLanguageLevel
  testName      String?
  score         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@index([language])
  @@index([level])
}

model CandidateActivityExperience {
  id                 String                @id @default(uuid())
  candidateProfileId String
  title              String
  activityType       CandidateActivityType
  organization       String?
  startDate          DateTime?
  endDate            DateTime?
  description        String?
  skills             String[]              @default([])
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@index([activityType])
}

// A user-authored Korean-style resume. Users can keep multiple versions
// (e.g. one per target role). The structured fields live in `content` as
// JSON so the builder can evolve without a migration per field.
model Resume {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   Json     @default("{}")
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CommunityPost {
  id        String                @id @default(uuid())
  authorId  String?
  authorName String
  category  CommunityPostCategory
  title     String
  body      String
  imageUrls String[]              @default([])
  likes     Int                   @default(0)
  comments  Int                   @default(0)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  likedBy CommunityPostLike[]
  commentItems CommunityPostComment[]

  @@index([category])
  @@index([createdAt])
}

model CommunityPostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

model CommunityPostComment {
  id         String   @id @default(uuid())
  postId     String
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
}

model CompanyConsultationInquiry {
  id          String   @id @default(uuid())
  companyName String
  contactName String
  email       String
  phone       String?
  message     String
  locale      String   @default("ko")
  source      String   @default("platform-web")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

// Viral landing — oh-haeng (five-element) saju prediction. We persist
// the LLM result keyed by a short id so the user can share / revisit
// the result and so the post-signup redirect can look it back up.
// userId is filled in once the visitor signs up (if ever); the row is
// otherwise anonymous.
model SajuPrediction {
  id                     String    @id @default(uuid())
  name                   String
  gender                 String
  birthDate              DateTime
  birthTime              String?
  calendarType           String    @default("solar")
  interpretation         String
  details                Json?
  translations           Json?
  recommendedRoleNames   String[]
  recommendedPositionIds String[]
  shareSlug              String    @unique @default(cuid())
  inputHash              String?   @unique
  userId                 String?
  ipHash                 String?
  locale                 String    @default("ko")
  createdAt              DateTime  @default(now())
  claimedAt              DateTime?

  leads                  SajuLead[]

  @@index([userId])
  @@index([createdAt])
}

// "Profile Pool" — career info collected AFTER the (free) saju result,
// before signup. One lead per prediction (a person can refine theirs). The
// prediction itself is the "Raw Pool"; this row promotes them to the
// Profile Pool. userId is filled once they sign up (claim flow), at which
// point poolStage moves toward VERIFIED / RECOMMENDABLE.
model SajuLead {
  id               String          @id @default(uuid())
  predictionId     String?
  shareSlug        String?
  name             String?
  // Career info captured pre-signup (kept as strings for funnel flexibility;
  // enum values mirror the Candidate* enums where applicable).
  nationality      String?
  school           String?
  major            String?
  visaType         String?
  koreanLevel      String?
  englishLevel     String?
  preferredJobRole String?
  workType         String?
  contact          String?
  contactType      String?
  hasResume        Boolean?
  // Rule-based recommendation snapshot (no LLM cost) shown back to the user
  // and surfaced to ops so the funnel result is auditable.
  recommendedRoles String[]        @default([])
  improvements     String[]        @default([])
  recommendStatus  String?
  // Pool classification + auto-generated filter tags (nationality / role /
  // visa / language / work type).
  poolStage        String          @default("PROFILE")
  tags             String[]        @default([])
  // Consent is split by purpose (career-info collection vs. employer
  // referral) per the privacy design.
  consentCareer    Boolean         @default(false)
  consentRecommend Boolean         @default(false)
  userId           String?
  locale           String          @default("ko")
  ipHash           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  prediction       SajuPrediction? @relation(fields: [predictionId], references: [id], onDelete: SetNull)

  @@index([predictionId])
  @@index([userId])
  @@index([poolStage])
  @@index([createdAt])
}
